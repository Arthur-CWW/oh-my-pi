{
  "name": "x-bookmark-sync-devtools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DevTools panel for capturing X/Twitter bookmark-related network responses.",
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "check": "bun run typecheck && bun run build && bun scripts/check-extension.mjs",
    "zip": "bun run build && bun scripts/zip.mjs",
    "launch:helium": "bun run build && ./scripts/launch-helium.sh",
    "launch:chrome": "bun run build && bash ./scripts/launch-chrome.sh",
    "launch:chrome:dev": "bash ./scripts/dev-chrome.sh"
  },
  "dependencies": {
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/chrome": "^0.1.42",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12"
  }
}
