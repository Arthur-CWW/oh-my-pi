{
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2024", "DOM"],
		"types": ["node"],
		"noEmit": true,
		"allowJs": false,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"baseUrl": ".",
		"paths": {
			"#kagi/*": ["./packages/kagi/src/*"]
		},
		"skipLibCheck": true,
		"moduleDetection": "force",
		"verbatimModuleSyntax": true,
		"strict": false,
		"forceConsistentCasingInFileNames": true,
		"plugins": []
	},
	"include": ["src/**/*.ts", "scripts/**/*.ts", "skills/**/*.ts", "packages/kagi/src/**/*.ts", "packages/kagi/scripts/**/*.ts", "packages/legacy-web-access/src/**/*.ts", "packages/legacy-web-access/test/**/*.ts"],
	"exclude": ["node_modules", "test-output"]
}
