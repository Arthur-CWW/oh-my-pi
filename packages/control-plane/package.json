{
  "name": "@wirebabel/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SQLite ledger foundation for the agent control plane",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "control-plane": "./src/cli.ts",
    "control-plane-storage": "./src/storage-cli.ts",
    "control-plane-storage-daemon": "./src/storage-daemon.ts"
  },
  "omp": {
    "extensions": [
      "./dist/omp-publisher.extension.js"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test",
    "cli": "bun run src/cli.ts",
    "daemon": "bun run src/daemon.ts",
    "storage": "bun run src/storage-cli.ts",
    "storage:status": "bun run src/storage-cli.ts status",
    "storage:dry-run": "bun run src/storage-cli.ts maintain --dry-run",
    "storage:apply": "bun run src/storage-cli.ts maintain --apply",
    "storage:daemon": "bun run src/storage-daemon.ts",
    "dev": "bun --watch src/daemon.ts",
    "dev:up": "./scripts/dev-up.sh",
    "evidence": "bun run src/evidence-cli.ts",
    "evidence:curate:gpt56": "bun run scripts/curate-gpt56-release.ts",
    "build:extension": "bun build src/omp-publisher.ts --bundle --target=bun --outfile=dist/omp-publisher.extension.js"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.0",
    "effect": "4.0.0-beta.98"
  },
  "devDependencies": {
    "bun-types": "^1.3.9",
    "typescript": "^5.9.3"
  }
}
