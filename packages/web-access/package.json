{
  "name": "@wirebabel/pi-web-access",
  "version": "0.10.3",
  "description": "Web search, content fetching, and YouTube transcripts for Pi coding agent",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "web-search",
    "fetch"
  ],
  "author": "wirebabel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arthur-CWW/pi-workflows.git",
    "directory": "packages/web-access"
  },
  "bin": {
    "pi-web-search": "./src/cli.ts",
    "pi-chatgpt": "./src/chatgpt-cli.ts",
    "pi-llm-browser": "./src/frontend-browser-cli.ts",
    "pi-cockpit": "./src/agent-cockpit-cli.ts"
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "bun test ./test ./src",
    "check": "bun run typecheck && bun run test",
    "search": "bun run src/cli.ts",
    "chatgpt": "bun run src/chatgpt-cli.ts",
    "llm-browser": "bun run src/frontend-browser-cli.ts",
    "cockpit": "bun run src/agent-cockpit-cli.ts",
    "kagi-search": "bun run src/cli.ts --provider kagi"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "effect": "^4.0.0-beta.71",
    "linkedom": "^0.16.0",
    "puppeteer-core": "^24.26.1",
    "turndown": "^7.2.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills/background-browser-automation",
      "./skills/librarian",
      "./skills/llm-frontend-browser",
      "./skills/macos-computer-use",
      "./skills/proof-of-work-qa",
      "./skills/rubber-duck-adversarial",
      "./skills/source-archive"
    ]
  },
  "piManifestNote": "The repo root also loads ./packages/web-access/skills/jimeng-browser-proxy for local Jimeng provider work; the published @wirebabel/pi-web-access package intentionally excludes that repo-local skill.",
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.48",
    "@types/node": "^25.2.3",
    "@types/turndown": "^5.0.6",
    "bun-types": "^1.3.9",
    "typescript": "^5.9.3",
    "@oh-my-pi/pi-ai": "15.12.3",
    "@oh-my-pi/pi-coding-agent": "15.12.3"
  }
}
