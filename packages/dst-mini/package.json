{
  "name": "@wirebabel/dst-mini",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop-friendly deterministic simulation testing prototype for Pi workflows",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "bench": "bun src/bench.ts --fixed --seeds 10000 --steps 80",
    "demo": "bun src/cli.ts --buggy --seeds 200",
    "replay": "bun src/cli.ts --buggy --seed",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "bun-types": "^1.3.9",
    "typescript": "^5.9.3"
  }
}
