{
  "name": "@wirebabel/ast-grep-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Advisory AST-grep guard extension for Pi coding agent",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "ast-grep"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "bun test ./test ./src",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "effect": "^4.0.0-beta.71"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "bun-types": "^1.3.9",
    "typescript": "^5.9.3",
    "@oh-my-pi/pi-coding-agent": "15.12.3"
  }
}
