{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun-types"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "extension/protocol.ts",
    "extension/frame.ts",
    "extension/transcript.ts",
    "extension/metadata.ts",
    "extension/client.ts",
    "extension/runtime.ts",
    "extension/index.ts",
    "extension/test/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
