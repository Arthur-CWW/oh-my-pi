[Unit]
Description=Remote authentication GDM verifier (inactive policy by default)
After=local-fs.target systemd-tmpfiles-setup.service
RequiresMountsFor=/etc/remote-auth-broker /var/lib/remote-auth-broker
ConditionPathExists=/etc/remote-auth-broker/gdm.json
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/libexec/remote-auth-broker/current/bin/remote-auth-gdmd --config /etc/remote-auth-broker/gdm.json
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=10s
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
UMask=0077
LimitCORE=0
LimitMEMLOCK=16777216
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
ProtectProc=default
ProcSubset=all
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_READ_SEARCH CAP_IPC_LOCK CAP_SYS_PTRACE
AmbientCapabilities=
DevicePolicy=closed
KeyringMode=private
RemoveIPC=yes
IPAddressDeny=any
ReadOnlyPaths=/etc/remote-auth-broker /proc /run/systemd /sys/fs/cgroup
ReadWritePaths=/run/remote-auth-broker/gdm /var/lib/remote-auth-broker/gdm
InaccessiblePaths=/home /root /media /mnt
StandardOutput=journal
StandardError=journal
SyslogIdentifier=remote-auth-gdmd

[Install]
WantedBy=multi-user.target
