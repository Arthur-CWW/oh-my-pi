{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arthur.local/remote-auth-broker/wire-v1.schema.json",
  "title": "Remote Auth Broker wire protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/executionRequest" },
    { "$ref": "#/$defs/grant" },
    { "$ref": "#/$defs/receipt" },
    { "$ref": "#/$defs/publicStatus" },
    { "$ref": "#/$defs/controlRequest" },
    { "$ref": "#/$defs/gdmChallenge" },
    { "$ref": "#/$defs/gdmEnvelope" },
    { "$ref": "#/$defs/gdmClaim" },
    { "$ref": "#/$defs/sudoSignedRequest" },
    { "$ref": "#/$defs/reviewerResult" }
  ],
  "$defs": {
    "protocolVersion": { "const": 1 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,86}$" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,64}$" },
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "grantId": { "type": "string", "pattern": "^grant-v1:[A-Za-z0-9_-]{22,64}$" },
    "b64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 524288 },
    "ciphertext": { "type": "string", "minLength": 22, "maxLength": 524288, "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048]|[A-Za-z0-9_-]{4})$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "time": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "u32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "ownershipSocketPath": { "type": "string", "maxLength": 103, "pattern": "^/(?:[^/]+/)+owners-v1/[0-9a-f]{64}/claim/owner[.]sock$" },
    "domain": { "enum": ["desktop-browser", "sudo"] },
    "operation": { "enum": ["gdm-login", "bitwarden-unlock", "website-autofill", "sudo"] },
    "authorizationMode": { "enum": ["delegated", "biometric-one-shot"] },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "publicError": {
      "enum": ["inactive", "disabled", "unavailable", "timeout", "cancelled", "protocol-invalid", "frame-invalid", "excess-field", "noncanonical-value", "principal-invalid", "owner-stale", "peer-mismatch", "request-expired", "request-replayed", "body-conflict", "grant-required", "grant-forbidden", "grant-invalid", "policy-mismatch", "domain-mismatch", "target-mismatch", "review-blocked", "signature-invalid", "ciphertext-invalid", "challenge-invalid", "claim-rejected", "execution-failed", "integrity-failure", "internal"]
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "ownerEpoch", "pid", "uid", "codeIdentity", "buildDigest", "runnerInstanceIdentity", "ownershipSocketPath"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/text" },
        "ownerEpoch": { "$ref": "#/$defs/uuid" },
        "pid": { "$ref": "#/$defs/u32" },
        "uid": { "$ref": "#/$defs/u32" },
        "codeIdentity": { "$ref": "#/$defs/text" },
        "buildDigest": { "$ref": "#/$defs/digest" },
        "runnerInstanceIdentity": { "$ref": "#/$defs/text" },
        "ownershipSocketPath": { "$ref": "#/$defs/ownershipSocketPath" }
      }
    },
    "gdmTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "sshHostKeyDigest", "machineId", "bootId", "username", "uid", "pamService", "seat", "tty", "rhost", "greeterGeneration", "jetkvmDeviceId", "controllerGeneration"],
      "properties": {
        "kind": { "const": "gdm" }, "sshHostKeyDigest": { "$ref": "#/$defs/digest" }, "machineId": { "$ref": "#/$defs/text" }, "bootId": { "$ref": "#/$defs/text" }, "username": { "$ref": "#/$defs/text" }, "uid": { "$ref": "#/$defs/u32" }, "pamService": { "const": "gdm-password" }, "seat": { "$ref": "#/$defs/text" }, "tty": { "$ref": "#/$defs/text" }, "rhost": { "enum": ["empty", "local"] }, "greeterGeneration": { "$ref": "#/$defs/time" }, "jetkvmDeviceId": { "$ref": "#/$defs/text" }, "controllerGeneration": { "$ref": "#/$defs/time" }
      }
    },
    "bitwardenTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "hostIdentity", "graphicalSessionId", "chromeService", "chromeExecutableDigest", "chromePid", "profileIdentity", "browserTargetId", "windowId", "extensionId", "extensionVersion", "extensionSource", "manifestDigest", "uiTarget"],
      "properties": {
        "kind": { "const": "bitwarden" }, "hostIdentity": { "$ref": "#/$defs/text" }, "graphicalSessionId": { "$ref": "#/$defs/text" }, "chromeService": { "$ref": "#/$defs/text" }, "chromeExecutableDigest": { "$ref": "#/$defs/digest" }, "chromePid": { "$ref": "#/$defs/u32" }, "profileIdentity": { "$ref": "#/$defs/text" }, "browserTargetId": { "$ref": "#/$defs/text" }, "windowId": { "$ref": "#/$defs/text" }, "extensionId": { "$ref": "#/$defs/text" }, "extensionVersion": { "$ref": "#/$defs/text" }, "extensionSource": { "const": "official-chrome-web-store" }, "manifestDigest": { "$ref": "#/$defs/digest" }, "uiTarget": { "$ref": "#/$defs/text" }
      }
    },
    "websiteTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "hostIdentity", "graphicalSessionId", "chromeService", "chromeExecutableDigest", "chromePid", "profileIdentity", "browserTargetId", "windowId", "extensionId", "extensionVersion", "extensionSource", "manifestDigest", "uiTarget", "originSet", "activeTabId", "frameId", "formActionOrigin", "foregroundWindowId", "credentialPairingId"],
      "properties": {
        "kind": { "const": "website" }, "hostIdentity": { "$ref": "#/$defs/text" }, "graphicalSessionId": { "$ref": "#/$defs/text" }, "chromeService": { "$ref": "#/$defs/text" }, "chromeExecutableDigest": { "$ref": "#/$defs/digest" }, "chromePid": { "$ref": "#/$defs/u32" }, "profileIdentity": { "$ref": "#/$defs/text" }, "browserTargetId": { "$ref": "#/$defs/text" }, "windowId": { "$ref": "#/$defs/text" }, "extensionId": { "$ref": "#/$defs/text" }, "extensionVersion": { "$ref": "#/$defs/text" }, "extensionSource": { "const": "official-chrome-web-store" }, "manifestDigest": { "$ref": "#/$defs/digest" }, "uiTarget": { "$ref": "#/$defs/text" },
        "originSet": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^https://[a-z0-9.-]+(?::[0-9]{1,5})?$", "maxLength": 253 } }, "activeTabId": { "$ref": "#/$defs/text" }, "frameId": { "$ref": "#/$defs/text" }, "formActionOrigin": { "type": "string", "pattern": "^https://[a-z0-9.-]+(?::[0-9]{1,5})?$", "maxLength": 253 }, "foregroundWindowId": { "$ref": "#/$defs/text" }, "credentialPairingId": { "$ref": "#/$defs/text" }
      }
    },
    "sudoTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "sshHostKeyDigest", "machineId", "bootId", "username", "uid", "sudoPolicyDigest", "actionId", "executable", "argvDigest"],
      "properties": {
        "kind": { "const": "sudo" }, "sshHostKeyDigest": { "$ref": "#/$defs/digest" }, "machineId": { "$ref": "#/$defs/text" }, "bootId": { "$ref": "#/$defs/text" }, "username": { "$ref": "#/$defs/text" }, "uid": { "$ref": "#/$defs/u32" }, "sudoPolicyDigest": { "$ref": "#/$defs/digest" }, "actionId": { "$ref": "#/$defs/text" }, "executable": { "type": "string", "pattern": "^/(?:[^/\\u0000-\\u001f\\u007f]+/)*[^/\\u0000-\\u001f\\u007f]+$", "maxLength": 512 }, "argvDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "target": { "oneOf": [{ "$ref": "#/$defs/gdmTarget" }, { "$ref": "#/$defs/bitwardenTarget" }, { "$ref": "#/$defs/websiteTarget" }, { "$ref": "#/$defs/sudoTarget" }] },
    "executionRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "nonce", "createdAt", "expiresAt", "principal", "authorizationModeRequested", "domain", "operation", "target", "purpose", "grantId"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" }, "requestId": { "$ref": "#/$defs/requestId" }, "nonce": { "$ref": "#/$defs/nonce" }, "createdAt": { "$ref": "#/$defs/time" }, "expiresAt": { "$ref": "#/$defs/time" }, "principal": { "$ref": "#/$defs/principal" }, "authorizationModeRequested": { "$ref": "#/$defs/authorizationMode" }, "domain": { "$ref": "#/$defs/domain" }, "operation": { "$ref": "#/$defs/operation" }, "target": { "$ref": "#/$defs/target" }, "purpose": { "$ref": "#/$defs/text" }, "grantId": { "oneOf": [{ "$ref": "#/$defs/grantId" }, { "type": "null" }] }
      }
    },
    "principalSelector": {
      "type": "object", "additionalProperties": false,
      "required": ["sessionId", "ownerEpoch", "uid", "codeIdentity", "buildDigest"],
      "properties": { "sessionId": { "$ref": "#/$defs/text" }, "ownerEpoch": { "$ref": "#/$defs/uuid" }, "uid": { "$ref": "#/$defs/u32" }, "codeIdentity": { "$ref": "#/$defs/text" }, "buildDigest": { "$ref": "#/$defs/digest" } }
    },
    "grant": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "grantId", "principalSelector", "domain", "operation", "targetPredicate", "riskCeiling", "issuedAt", "expiresAt", "revokedAt", "consumedAt", "policyDigest", "brokerBuildDigest", "brokerCodeIdentity", "biometricEvidenceId", "biometricIssuedAt", "lifecycleState"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" }, "grantId": { "$ref": "#/$defs/grantId" }, "principalSelector": { "$ref": "#/$defs/principalSelector" }, "domain": { "$ref": "#/$defs/domain" }, "operation": { "$ref": "#/$defs/operation" }, "targetPredicate": { "$ref": "#/$defs/target" }, "riskCeiling": { "$ref": "#/$defs/risk" }, "issuedAt": { "$ref": "#/$defs/time" }, "expiresAt": { "$ref": "#/$defs/time" }, "revokedAt": { "oneOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] }, "consumedAt": { "oneOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] }, "policyDigest": { "$ref": "#/$defs/digest" }, "brokerBuildDigest": { "$ref": "#/$defs/digest" }, "brokerCodeIdentity": { "$ref": "#/$defs/text" }, "biometricEvidenceId": { "$ref": "#/$defs/id" }, "biometricIssuedAt": { "$ref": "#/$defs/time" }, "lifecycleState": { "enum": ["active", "consumed", "expired", "revoked", "invalidated"] }
      }
    },
    "receiptEvents": {
      "type": "object", "additionalProperties": false,
      "required": ["requestedAt", "authorizedAt", "executingAt", "terminalAt"],
      "properties": { "requestedAt": { "$ref": "#/$defs/time" }, "authorizedAt": { "oneOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] }, "executingAt": { "oneOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] }, "terminalAt": { "oneOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] } }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "receiptId", "requestId", "grantId", "domain", "operation", "authorizationModeUsed", "targetFingerprint", "state", "errorCode", "events", "policyDigest", "brokerBuildDigest", "brokerCodeDigest", "targetReleaseDisposition", "browserTargetGeneration"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" }, "receiptId": { "$ref": "#/$defs/id" }, "requestId": { "$ref": "#/$defs/requestId" }, "grantId": { "oneOf": [{ "$ref": "#/$defs/grantId" }, { "type": "null" }] }, "domain": { "$ref": "#/$defs/domain" }, "operation": { "$ref": "#/$defs/operation" }, "authorizationModeUsed": { "$ref": "#/$defs/authorizationMode" }, "targetFingerprint": { "$ref": "#/$defs/digest" }, "state": { "enum": ["requested", "authorized", "executing", "succeeded", "failed", "cancelled", "expired", "revoked", "disabled"] }, "errorCode": { "oneOf": [{ "$ref": "#/$defs/publicError" }, { "type": "null" }] }, "events": { "$ref": "#/$defs/receiptEvents" }, "policyDigest": { "$ref": "#/$defs/digest" }, "brokerBuildDigest": { "$ref": "#/$defs/digest" }, "brokerCodeDigest": { "$ref": "#/$defs/digest" }, "targetReleaseDisposition": { "enum": ["not-applicable", "quarantined", "destroyed", "closed"] }, "browserTargetGeneration": { "oneOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] }
      }
    },
    "endpointStatus": {
      "type": "object", "additionalProperties": false, "required": ["ready", "errorCode"],
      "properties": { "ready": { "type": "boolean" }, "errorCode": { "oneOf": [{ "$ref": "#/$defs/publicError" }, { "type": "null" }] } }
    },
    "publicStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "canonicalStatus", "policyDigest", "installedBuildDigest", "runningBuildDigest", "codeIdentity", "pid", "socketPosture", "jetkvmControllerGeneration", "gdm", "browser", "sudo", "errors"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" }, "canonicalStatus": { "enum": ["DESIGN/INACTIVE", "ACTIVE", "DISABLED", "DEGRADED"] }, "policyDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "installedBuildDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "runningBuildDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "codeIdentity": { "oneOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] }, "pid": { "oneOf": [{ "$ref": "#/$defs/u32" }, { "type": "null" }] }, "socketPosture": { "enum": ["absent", "owner-only", "invalid"] }, "jetkvmControllerGeneration": { "oneOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] }, "gdm": { "$ref": "#/$defs/endpointStatus" }, "browser": { "$ref": "#/$defs/endpointStatus" }, "sudo": { "$ref": "#/$defs/endpointStatus" }, "errors": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/publicError" } }
      }
    },
    "controlRequest": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["action", "requestId"], "properties": { "action": { "const": "request-state" }, "requestId": { "$ref": "#/$defs/requestId" } } },
        { "type": "object", "additionalProperties": false, "required": ["action", "requestId"], "properties": { "action": { "const": "cancel" }, "requestId": { "$ref": "#/$defs/requestId" } } },
        { "type": "object", "additionalProperties": false, "required": ["action"], "properties": { "action": { "const": "grant-list" } } },
        { "type": "object", "additionalProperties": false, "required": ["action", "grantId"], "properties": { "action": { "const": "grant-revoke" }, "grantId": { "$ref": "#/$defs/grantId" } } },
        { "type": "object", "additionalProperties": false, "required": ["action", "grantId"], "properties": { "action": { "const": "grant-expire" }, "grantId": { "$ref": "#/$defs/grantId" } } },
        { "type": "object", "additionalProperties": false, "required": ["action", "credentialId"], "properties": { "action": { "const": "credential-forget" }, "credentialId": { "$ref": "#/$defs/id" } } },
        { "type": "object", "additionalProperties": false, "required": ["action", "reason"], "properties": { "action": { "const": "emergency-disable" }, "reason": { "$ref": "#/$defs/text" } } },
        { "type": "object", "additionalProperties": false, "required": ["action"], "properties": { "action": { "const": "re-enable" } } },
        { "type": "object", "additionalProperties": false, "required": ["action"], "properties": { "action": { "const": "status" } } }
      ]
    },
    "gdmChallenge": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "challengeId", "challenge", "bootId", "issuedBoottimeMs", "expiresBoottimeMs", "policyDigest"],
      "properties": { "protocolVersion": { "$ref": "#/$defs/protocolVersion" }, "challengeId": { "$ref": "#/$defs/id" }, "challenge": { "$ref": "#/$defs/nonce" }, "bootId": { "$ref": "#/$defs/text" }, "issuedBoottimeMs": { "$ref": "#/$defs/time" }, "expiresBoottimeMs": { "$ref": "#/$defs/time" }, "policyDigest": { "$ref": "#/$defs/digest" } }
    },
    "gdmEnvelope": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "request", "challenge", "issueId", "sentinelHash", "hpkeEnc", "ciphertext", "signingKeyId", "signature"],
      "properties": { "protocolVersion": { "$ref": "#/$defs/protocolVersion" }, "request": { "$ref": "#/$defs/executionRequest" }, "challenge": { "$ref": "#/$defs/gdmChallenge" }, "issueId": { "$ref": "#/$defs/id" }, "sentinelHash": { "$ref": "#/$defs/digest" }, "hpkeEnc": { "$ref": "#/$defs/b64url" }, "ciphertext": { "$ref": "#/$defs/ciphertext" }, "signingKeyId": { "$ref": "#/$defs/id" }, "signature": { "$ref": "#/$defs/b64url" } }
    },
    "gdmClaim": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "nonce", "issueId", "sentinel", "username", "uid", "pamService", "seat", "tty", "rhost", "greeterGeneration", "controllerGeneration"],
      "properties": { "protocolVersion": { "$ref": "#/$defs/protocolVersion" }, "requestId": { "$ref": "#/$defs/requestId" }, "nonce": { "$ref": "#/$defs/nonce" }, "issueId": { "$ref": "#/$defs/id" }, "sentinel": { "type": "string", "pattern": "^gdm-broker-v1:[A-Za-z0-9_-]{43}$" }, "username": { "$ref": "#/$defs/text" }, "uid": { "$ref": "#/$defs/u32" }, "pamService": { "const": "gdm-password" }, "seat": { "$ref": "#/$defs/text" }, "tty": { "$ref": "#/$defs/text" }, "rhost": { "enum": ["empty", "local"] }, "greeterGeneration": { "$ref": "#/$defs/time" }, "controllerGeneration": { "$ref": "#/$defs/time" } }
    },
    "sudoSignedRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "request", "canonicalBodyDigest", "signingKeyId", "signature"],
      "properties": { "protocolVersion": { "$ref": "#/$defs/protocolVersion" }, "request": { "$ref": "#/$defs/executionRequest" }, "canonicalBodyDigest": { "$ref": "#/$defs/digest" }, "signingKeyId": { "$ref": "#/$defs/id" }, "signature": { "$ref": "#/$defs/b64url" } }
    },
    "reviewerReason": { "enum": ["semantic_allow", "semantic_deny", "semantic_escalate", "timeout", "cancelled", "model_failure", "session_failure", "provider_failure", "transport_failure", "parse_failure", "missing_evidence", "prompt_injection", "digest_mismatch", "truncated_input", "omitted_security_field", "canonical_action_unreconstructable", "reviewer_setup_failure"] },
    "reviewerResult": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "reviewId", "canonicalRequestDigest", "reviewerModel", "reviewerBuildDigest", "promptPolicyDigest", "risk", "userAuthorization", "status", "outcome", "reasonCode", "reason", "rationale", "attemptCount", "startedAt", "completedAt", "expiresAt"],
      "properties": { "protocolVersion": { "$ref": "#/$defs/protocolVersion" }, "reviewId": { "$ref": "#/$defs/id" }, "canonicalRequestDigest": { "$ref": "#/$defs/digest" }, "reviewerModel": { "$ref": "#/$defs/text" }, "reviewerBuildDigest": { "$ref": "#/$defs/digest" }, "promptPolicyDigest": { "$ref": "#/$defs/digest" }, "risk": { "$ref": "#/$defs/risk" }, "userAuthorization": { "enum": ["unknown", "low", "medium", "high"] }, "status": { "enum": ["completed", "failed", "cancelled"] }, "outcome": { "enum": ["allow", "deny", "escalate", "blocked"] }, "reasonCode": { "$ref": "#/$defs/reviewerReason" }, "reason": { "$ref": "#/$defs/text" }, "rationale": { "$ref": "#/$defs/text" }, "attemptCount": { "type": "integer", "minimum": 1, "maximum": 3 }, "startedAt": { "$ref": "#/$defs/time" }, "completedAt": { "$ref": "#/$defs/time" }, "expiresAt": { "$ref": "#/$defs/time" } }
    }
  }
}
