{
  "name": "@wirebabel/remotion-renderer",
  "version": "0.1.0",
  "private": true,
  "description": "Node-based Remotion renderer for clean-room TikTok-style documentary recreations",
  "type": "module",
  "main": "./src/render.ts",
  "types": "./src/render.ts",
  "exports": {
    ".": {
      "types": "./src/render.ts",
      "import": "./src/render.ts"
    },
    "./render": {
      "types": "./src/render.ts",
      "import": "./src/render.ts"
    }
  },
  "bin": {
    "remotion-render": "./src/render.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests yet\"",
    "render": "bun x tsx src/render.ts",
    "render:node": "bun x tsx src/render.ts"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
