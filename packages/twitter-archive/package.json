{
  "name": "@wirebabel/twitter-archive",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Twitter/X archive capture, normalization, and search helpers",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun src/dev.ts",
    "typecheck": "tsc --noEmit",
    "check:types": "tsc --noEmit",
    "test": "bun test",
    "smoke:nitter:communalai": "bun src/nitter-smoke.ts",
    "worker:nitter": "bun src/backfill-worker.ts",
    "worker:nitter:queued": "bun src/queued-backfill-worker.ts --daemon",
    "worker:nitter:queued:once": "bun src/queued-backfill-worker.ts --once",
    "queue:account": "bun src/backfill-queue-cli.ts add",
    "queue:status": "bun src/backfill-queue-cli.ts status",
    "sync:tick": "bun src/sync-cli.ts tick",
    "sync:daemon": "bun src/sync-cli.ts daemon",
    "corpus:sync": "bun src/corpus/cli.ts sync",
    "corpus:backfill": "bun src/corpus/cli.ts backfill",
    "corpus:search": "bun src/corpus/cli.ts search",
    "corpus:status": "bun src/corpus/cli.ts status",
    "public-source:sync": "bun src/public-source-cli.ts sync",
    "public-source:import": "bun src/public-source-cli.ts import",
    "public-source:search": "bun src/public-source-cli.ts search",
    "public-source:report": "bun src/public-source-cli.ts report"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.0",
    "effect": "4.0.0-beta.98",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "bun-types": "^1.3.9",
    "typescript": "^5.9.3"
  }
}
