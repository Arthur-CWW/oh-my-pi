{
  "name": "@wirebabel/twitter-archive",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Twitter/X archive capture, normalization, and search helpers",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun src/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke:nitter:communalai": "bun src/nitter-smoke.ts",
    "worker:nitter": "bun src/backfill-worker.ts",
    "worker:nitter:queued": "bun src/queued-backfill-worker.ts --daemon",
    "worker:nitter:queued:once": "bun src/queued-backfill-worker.ts --once"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.0",
    "effect": "^4.0.0-beta.71",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.9.3",
    "bun-types": "^1.3.9",
    "@types/node": "^25.2.3",
    "@types/sql.js": "^1.4.11"
  }
}
