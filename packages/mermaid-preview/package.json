{
  "name": "@wirebabel/pi-mermaid-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Automatic Mermaid previews for Pi terminal sessions",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "mermaid"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "bun test ./test ./src",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "beautiful-mermaid": "^1.1.3"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "*",
    "@oh-my-pi/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "bun-types": "^1.3.9",
    "typescript": "^5.9.3",
    "@oh-my-pi/pi-coding-agent": "15.12.3",
    "@oh-my-pi/pi-tui": "15.12.3"
  }
}
