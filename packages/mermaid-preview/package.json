{
  "name": "@wirebabel/pi-mermaid-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Automatic Mermaid previews for Pi terminal sessions",
  "type": "module",
  "keywords": ["pi-package", "pi", "extension", "mermaid"],
  "license": "MIT",
  "pi": {
    "extensions": ["./src/index.ts"]
