{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "paths": { "@/*": ["./ui/src/*"] },
    "types": ["bun-types", "node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
