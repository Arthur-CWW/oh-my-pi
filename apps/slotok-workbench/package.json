{
  "name": "@wirebabel/slotok-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Slotok local-first AI video/UGC pipeline workbench",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "bun run dev:renderer",
    "dev:daemon": "bun src/daemon/server.ts",
    "demo:workflows": "bun scripts/run-demo-workflows.ts",
    "dev:renderer": "vite --host 127.0.0.1 --port 47521",
    "dev:electron": "SLOTOK_RENDERER_URL=http://127.0.0.1:47521 electron .",
    "smoke:daemon": "bun src/daemon/server.ts --once",
    "visual:qa": "bun scripts/visual-qa.ts",
    "test": "vitest run && bun test ./src/daemon/eval-store.bun.test.ts ./src/daemon/ugc-sqlite-store.bun.test.ts",
    "test:update": "vitest run --update",
    "build": "bun run build:renderer && bun run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.5",
    "@wirebabel/ugc-cli": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5",
    "autoprefixer": "^10.5.0",
    "electron": "^39.2.6",
    "happy-dom": "^20.0.11",
    "postcss": "^8.5.15",
    "tailwindcss": "3",
    "typescript": "^5.9.3",
    "vite": "7.3.5",
    "vitest": "^4.0.15"
  }
}
