#!/usr/bin/env bash
set -euo pipefail

REAL_OMP="${OMP_REAL:-${HOME}/.bun/bin/omp}"
AGENT_MUX_CLI="${OMP_AGENT_MUX_CLI:-${HOME}/agents/packages/agent-mux/src/cli.ts}"

is_interactive_launch() {
  [[ -t 0 && -t 1 && -n "${CMUX_WORKSPACE_ID:-}" && -n "${CMUX_SURFACE_ID:-}" && -n "${TTY:-}" ]] || return 1
  [[ -f "${AGENT_MUX_CLI}" ]] || return 1
  local previous=""
  for arg in "$@"; do
    case "${arg}" in
      -p|--print|--help|-h|--version|-v|--smoke-test) return 1 ;;
      --mode=rpc|--mode=rpc-ui|--mode=acp) return 1 ;;
      rpc|rpc-ui|acp)
        [[ "${previous}" == "--mode" || "${arg}" == "${1:-}" ]] && return 1
        ;;
    esac
    previous="${arg}"
  done
  case "${1:-}" in
    acp|agents|auth-broker|auth-gateway|bench|commit|completions|__complete|config|dry-balance|gallery|grep|grievances|help|install|irc|join|models|plugin|read|say|search|setup|shell|ssh|stats|tiny-models|token|update|usage|worktree|wt) return 1 ;;
  esac
  return 0
}

mux_name() {
  local scope="${OMP_WORKSTREAM:-}"
  if [[ -z "${scope}" && "${PWD}" =~ /streams/([a-z0-9]+(-[a-z0-9]+)*)/?$ ]]; then
    scope="${BASH_REMATCH[1]}"
  fi
  if [[ -n "${scope}" ]]; then
    printf 'cmux-%s-workstream-%s' "${CMUX_WORKSPACE_ID}" "${scope}"
  else
    printf 'cmux-%s-surface-%s' "${CMUX_WORKSPACE_ID}" "${CMUX_SURFACE_ID}"
  fi
}

if [[ "${1:-}" == "update" ]]; then
  echo "omp: self-update is disabled for the local fork command" >&2
  echo "omp: run 'mise run omp-promote' or 'mise run omp-build-fork' from ~/agents" >&2
  echo "omp: use 'omp-old' for the isolated upstream release" >&2
  exit 2
fi

if [[ ! -x "${REAL_OMP}" ]]; then
  echo "omp: fork binary not found: ${REAL_OMP}" >&2
  echo "omp: run 'mise run omp-install' from ~/agents" >&2
  exit 127
fi

if is_interactive_launch "$@"; then
  MUX_NAME="$(mux_name)"
  bun "${AGENT_MUX_CLI}" new --name "${MUX_NAME}" --cwd "${PWD}" -- "${REAL_OMP}" "$@" >/dev/null
  exec bun "${AGENT_MUX_CLI}" attach "${MUX_NAME}" --mode control
fi

exec "${REAL_OMP}" "$@"
