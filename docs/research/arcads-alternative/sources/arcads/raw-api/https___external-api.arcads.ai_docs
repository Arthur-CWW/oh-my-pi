            "/v1/scripts": {
              "post": {
                "description": "Create a new script. You can specify either:\n    - folderId only: A new project will be created in that folder\n    - projectId only: The script will be added to the existing project\n    - Both folderId and projectId: The script will be added to the project, but only if the project belongs to that folder\n    \n    At least one of folderId or projectId must be provided.",
                "operationId": "createScript",
                "parameters": [],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/ScriptCreationDto"
                      }
                    }
                  }
                },
                "responses": {
                  "201": {
                    "description": "Script successfully created",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/ScriptDto"
                        }
                      }
                    }
                  },
                  "400": {
                    "description": "Invalid input: missing both folderId and projectId, or project does not belong to the specified folder"
                  },
                  "403": {
                    "description": "Authentication error"
                  },
                  "404": {
                    "description": "Folder, project, situation, or voice not found. Error message specifies which resource: FOLDER_NOT_FOUND, PROJECT_NOT_FOUND, SITUATION_NOT_FOUND, VOICE_NOT_FOUND"
                  },
                  "500": {
                    "description": "Unknown error"
                  }
                },
                "security": [
                  {
                    "basic": []
                  }
                ],
                "summary": "Create new script within folder or project",
                "tags": [
                  "Scripts"
                ]
              }
            },
