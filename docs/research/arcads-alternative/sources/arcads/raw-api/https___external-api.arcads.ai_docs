            },
            "/v1/presets": {
              "get": {
                "operationId": "getPresetTypes",
                "parameters": [],
                "responses": {
                  "200": {
                    "description": "Preset types list",
                    "content": {
                      "application/json": {
                        "schema": {
                          "type": "array",
                          "items": {
