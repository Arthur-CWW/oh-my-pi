              "CreateBRollDto": {
                "type": "object",
                "properties": {
                  "productId": {
                    "type": "string",
                    "description": "The ID of the product",
                    "example": "b972ffe0-3364-46ad-922e-211df4f1d441"
                  },
                  "projectId": {
                    "type": "string",
                    "description": "The ID of the project (optional)",
                    "example": "40c97d04-b1b8-45fa-878d-4490a729bf5f"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "The prompt describing the video content to generate",
                    "example": "A beautiful landscape with mountains and a lake at sunset"
                  },
                  "aspectRatio": {
                    "type": "string",
                    "description": "The aspect ratio of the video",
                    "enum": [
                      "1:1",
                      "16:9",
                      "9:16"
                    ],
                    "example": "16:9"
                  },
                  "duration": {
                    "type": "number",
                    "description": "The video duration in seconds",
                    "enum": [
                      5,
                      10
                    ],
                    "example": 10
                  },
                  "refImageAsBase64": {
                    "type": "string",
                    "description": "Optional reference image as base64 string (data:image/...;base64,...)",
                    "example": "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQ..."
                  },
                  "startFrameAsBase64": {
                    "type": "string",
                    "description": "Optional start frame image as base64 string (data:image/...;base64,...)",
                    "example": "data:image/webp;base64,UklGRggUCQBXRUJQVlA4WAoAAAAwAAAADwUA..."
                  },
                  "endFrameAsBase64": {
                    "type": "string",
                    "description": "Optional end frame image as base64 string (data:image/...;base64,...)",
                    "example": "data:image/webp;base64,UklGRggUCQBXRUJQVlA4WAoAAAAwAAAADwUA..."
                  }
                },
                "required": [
                  "productId",
                  "prompt",
                  "aspectRatio",
                  "duration"
                ]
              },
