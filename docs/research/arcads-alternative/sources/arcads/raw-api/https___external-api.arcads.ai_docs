            "/v1/assets/add-to-project": {
              "post": {
                "description": "\n      Associates an existing video asset with a project.\n      \n      **Features:**\n      - Links a video asset to a specific project\n      - Validates asset and project ownership\n      - Supports both public and workspace-owned assets\n      \n      **Authentication:** Requires Basic Auth with client credentials\n      \n      **Note:** The asset must exist and be accessible to the workspace, and the project must belong to the workspace.\n    ",
                "operationId": "addAssetToProject",
                "parameters": [],
                "requestBody": {
                  "required": true,
                  "description": "Asset and project identifiers",
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/AddAssetToProjectDto"
                      }
                    }
                  }
                },
                "responses": {
                  "201": {
                    "description": "Asset successfully added to project",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/AssetOperationResponseDto"
                        }
                      }
                    }
                  },
                  "403": {
                    "description": "Authentication error"
                  },
                  "404": {
                    "description": "Project or asset not found"
                  },
                  "500": {
                    "description": "Internal server error"
                  }
                },
                "security": [
                  {
                    "basic": []
                  }
                ],
                "summary": "Add an asset to a project",
                "tags": [
                  "Any Assets"
                ]
              }
            },
            "/v1/assets/remove-from-project": {
              "post": {
                "description": "\n      Removes the association between a video asset and a project.\n      \n      **Features:**\n      - Unlinks a video asset from a specific project\n      - Validates asset and project ownership\n      - Supports both public and workspace-owned assets\n      \n      **Authentication:** Requires Basic Auth with client credentials\n      \n      **Note:** The asset must exist and be accessible to the workspace, and the project must belong to the workspace. If the asset is not associated with the project, the operation will still succeed.\n    ",
                "operationId": "removeAssetFromProject",
                "parameters": [],
                "requestBody": {
                  "required": true,
                  "description": "Asset and project identifiers",
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/RemoveAssetFromProjectDto"
                      }
                    }
                  }
                },
                "responses": {
                  "201": {
                    "description": "Asset successfully removed from project",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/AssetOperationResponseDto"
                        }
                      }
                    }
                  },
                  "403": {
                    "description": "Authentication error"
                  },
                  "404": {
                    "description": "Project or asset not found"
                  },
                  "500": {
                    "description": "Internal server error"
                  }
                },
                "security": [
                  {
                    "basic": []
                  }
                ],
                "summary": "Remove an asset from a project",
                "tags": [
                  "Any Assets"
                ]
              }
            },
            "/v1/assets/{id}": {
              "get": {
                "description": "\n      Retrieves a video asset by its unique identifier.\n      \n      **Features:**\n      - Returns complete video asset information\n      - Supports both public and workspace-owned assets\n      - Includes URLs for video, thumbnail, and metadata\n      \n      **Authentication:** Requires Basic Auth with client credentials\n      \n      **Note:** The asset must exist and be accessible to the workspace (either owned by the workspace or public).\n    ",
                "operationId": "getAssetById",
                "parameters": [
                  {
                    "name": "id",
                    "required": true,
                    "in": "path",
                    "schema": {
                      "type": "string"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Video asset successfully retrieved",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/AssetResponseDto"
                        }
                      }
                    }
                  },
                  "403": {
                    "description": "Authentication error"
                  },
                  "404": {
                    "description": "Video asset not found"
                  },
                  "500": {
                    "description": "Internal server error"
                  }
                },
                "security": [
                  {
                    "basic": []
                  }
                ],
                "summary": "Get a video asset by ID",
                "tags": [
                  "Any Assets"
                ]
              }
            },
            "/v1/assets/{id}/watch": {
              "get": {
                "description": "\n      Retrieves a direct download link for a video asset if it's fully generated.\n\n      **Features:**\n      - Returns a signed URL for direct download\n      - Supports both public and workspace-owned assets\n      - Validates asset generation status\n\n      **Authentication:** Requires Basic Auth with client credentials\n\n      **Note:** The asset must be fully generated (status: GENERATED) to get the download link.\n    ",
                "operationId": "getAssetWatchLink",
                "parameters": [
                  {
                    "name": "id",
                    "required": true,
                    "in": "path",
                    "schema": {
                      "type": "string"
                    }
                  }
                ],
                "responses": {
                  "302": {
                    "description": "Asset successfully retrieved and redirected to download URL"
                  },
                  "403": {
                    "description": "Authentication error"
                  },
                  "404": {
                    "description": "Asset not found"
                  },
                  "422": {
                    "description": "Asset has not been generated yet"
                  },
                  "500": {
                    "description": "Internal server error"
                  }
                },
                "security": [
                  {
                    "basic": []
                  }
                ],
                "summary": "Get asset watch link",
                "tags": [
                  "Any Assets"
                ]
              }
            },
