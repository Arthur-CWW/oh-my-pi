                    }
                  },
                  {
                    "name": "pageSize",
                    "required": false,
                    "in": "query",
                    "schema": {
                      "default": 50,
                      "type": "number"
                    }
                  },
                  {
                    "name": "isPro",
                    "required": false,
                    "in": "query",
                    "schema": {
                      "type": "boolean"
                    }
                  },
                  {
                    "name": "talkingActorEnabled",
                    "required": false,
                    "in": "query",
                    "description": "Filter by talking-actor situations. Pass true for talking-actor content, false to exclude it (note: false narrows to non-talking content only, not any specific alternative). If NO content-type filter is provided, the API defaults to talkingActorEnabled=true for backward compatibility.",
                    "schema": {
                      "type": "boolean"
                    }
                  },
                  {
                    "name": "showYourAppEnabled",
                    "required": false,
                    "in": "query",
                    "description": "Filter by \"show your app\" situations.",
                    "schema": {
                      "type": "boolean"
                    }
                  },
                  {
                    "name": "unboxingPovEnabled",
                    "required": false,
                    "in": "query",
                    "description": "Filter by unboxing POV situations.",
                    "schema": {
                      "type": "boolean"
                    }
                  },
                  {
                    "name": "brollSora2Enabled",
                    "required": false,
                    "in": "query",
                    "description": "Filter by Sora-2 B-roll situations.",
                    "schema": {
                      "type": "boolean"
                    }
                  },
                  {
                    "name": "fashionTryOnEnabled",
                    "required": false,
                    "in": "query",
                    "description": "Filter by fashion try-on situations.",
                    "schema": {
                      "type": "boolean"
                    }
                  },
                  {
                    "name": "productShowcaseEnabled",
                    "required": false,
                    "in": "query",
                    "description": "Filter by product-showcase situations.",
                    "schema": {
                      "type": "boolean"
                    }
                  },
                  {
                    "name": "gesturesEnabled",
                    "required": false,
                    "in": "query",
                    "description": "Filter by gestures situations.",
                    "schema": {
                      "type": "boolean"
                    }
                  },
                  {
                    "name": "cameraMovementEnabled",
                    "required": false,
                    "in": "query",
                    "description": "Filter by camera-movement situations.",
                    "schema": {
                      "type": "boolean"
                    }
                  },
                  {
                    "name": "actorGender",
                    "required": false,
                    "in": "query",
                    "description": "Filter by actor gender (case-insensitive). Values: male, female. Only applies to actor-based situations; not supported alongside preset content-type filters (fashionTryOnEnabled, productShowcaseEnabled, gesturesEnabled, cameraMovementEnabled, unboxingPovEnabled, brollSora2Enabled).",
                    "schema": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "name": "actorAge",
                    "required": false,
                    "in": "query",
                    "description": "Filter by actor age (case-insensitive). Values: adult, senior, young adult. Only applies to actor-based situations; not supported alongside preset content-type filters.",
                    "schema": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "name": "actorName",
                    "required": false,
                    "in": "query",
                    "description": "Filter by actor name (case-insensitive LIKE search). Only applies to actor-based situations; not supported alongside preset content-type filters.",
                    "schema": {
                      "example": "john",
                      "type": "string"
                    }
                  },
                  {
                    "name": "actorFreeSpeech",
                    "required": false,
                    "in": "query",
                    "description": "Filter by actor free speech capability. Only applies to actor-based situations; not supported alongside preset content-type filters.",
                    "schema": {
                      "example": true,
                      "type": "boolean"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Situations list successfully retrieved",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/PaginatedSituations"
                        }
