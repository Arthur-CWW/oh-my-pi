                  "403": {
                    "description": "Authentication error"
                  },
                  "404": {
                    "description": "Folder not found"
                  },
                  "500": {
                    "description": "Unknown error"
                  }
                },
                "security": [
                  {
                    "basic": []
                  }
                ],
                "summary": "Get folder by ID",
                "tags": [
                  "Folders"
                ]
              },
              "put": {
                "operationId": "updateFolder",
                "parameters": [
                  {
                    "name": "folderId",
                    "required": true,
                    "in": "path",
                    "schema": {
                      "type": "string"
                    }
