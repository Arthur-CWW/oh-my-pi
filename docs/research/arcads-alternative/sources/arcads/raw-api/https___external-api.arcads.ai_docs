                ]
              }
            },
            "/v1/presets/{presetType}/templates": {
              "get": {
                "operationId": "getPresetTemplates",
                "parameters": [
                  {
                    "name": "presetType",
                    "required": true,
                    "in": "path",
                    "description": "The preset type to list templates for",
                    "schema": {
                      "enum": [
                        "camera-movement",
                        "fashion-tryon",
                        "gameplay-ad",
                        "gestures",
                        "product-showcase",
                        "showyourapp",
                        "unboxing-pov"
                      ],
                      "type": "string"
                    }
                  },
                  {
                    "name": "page",
                    "required": false,
                    "in": "query",
                    "schema": {
                      "default": 1,
                      "type": "number"
                    }
                  },
                  {
                    "name": "pageSize",
                    "required": false,
                    "in": "query",
                    "schema": {
                      "default": 50,
                      "type": "number"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Paginated preset templates",
                    "content": {
                      "application/json": {
                        "schema": {
