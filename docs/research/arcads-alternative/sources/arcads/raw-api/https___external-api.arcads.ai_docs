              "post": {
                "description": "Optional reference image: either upload via `POST /v1/file-upload/get-presigned-url` and pass `refImageFilePath`, or pass `refImageAsBase64`. When both are sent, `refImageFilePath` wins.",
                "operationId": "startVideo",
                "parameters": [],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/StartSora2Dto"
                      }
                    }
                  }
                },
                "responses": {
                  "201": {
                    "description": ""
                  }
                },
                "security": [
                  {
                    "basic": []
                  }
                ],
                "summary": "Trigger Sora2 text-to-video generation",
                "tags": [
                  "Sora2"
                ]
              }
            },
            "/v1/sora2/remix/video": {
              "post": {
                "operationId": "remixVideo",
                "parameters": [],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/RemixSora2Dto"
                      }
                    }
                  }
                },
                "responses": {
                  "201": {
                    "description": ""
                  }
                },
                "security": [
                  {
                    "basic": []
                  }
                ],
                "summary": "Trigger Sora2 video-to-video remix",
                "tags": [
                  "Sora2"
                ]
              }
            },
            "/v2/talking-actors/generate": {
              "post": {
                "operationId": "generate",
                "parameters": [],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/GenerateTalkingActorsDto"
                      }
                    }
                  }
                },
                "responses": {
                  "201": {
                    "description": "Generation started",
                    "content": {
                      "application/json": {
                        "schema": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/GenerationResultItemDto"
                          }
                        }
                      }
                    }
                  }
                },
                "security": [
                  {
                    "basic": []
                  }
                ],
                "summary": "Generate talking actor videos",
                "tags": [
                  "Talking Actors v2"
                ]
              }
            },
            "/v2/talking-actors/{id}": {
              "get": {
                "operationId": "getStatus",
                "parameters": [
                  {
                    "name": "id",
                    "required": true,
                    "in": "path",
                    "description": "Generation ID",
                    "schema": {
                      "type": "string"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "Generation status",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/TalkingActorStatusDto"
                        }
                      }
                    }
                  }
                },
                "security": [
                  {
                    "basic": []
                  }
                ],
                "summary": "Get talking actor generation status",
                "tags": [
                  "Talking Actors v2"
                ]
              }
            },
            "/v2/talking-actors/{id}/watch": {
              "get": {
                "operationId": "getWatchUrl",
                "parameters": [
                  {
                    "name": "id",
                    "required": true,
                    "in": "path",
                    "description": "Generation ID",
                    "schema": {
                      "type": "string"
                    }
                  }
                ],
                "responses": {
                  "302": {
                    "description": "Redirect to watch URL"
                  }
                },
                "security": [
                  {
                    "basic": []
                  }
                ],
                "summary": "Get talking actor watch URL",
                "tags": [
                  "Talking Actors v2"
                ]
              }
            },
            "/v1/veo31/generate/video": {
              "post": {
                "operationId": "startVideo",
                "parameters": [],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/StartVeo31Dto"
                      }
                    }
                  }
                },
                "responses": {
                  "201": {
                    "description": ""
                  }
                },
                "security": [
                  {
                    "basic": []
                  }
                ],
                "summary": "Trigger Veo31 text-to-video generation",
                "tags": [
                  "Veo31"
                ]
              }
            },
            "/v1/file-upload/get-presigned-url": {
              "post": {
                "operationId": "generatePresignedUrl",
                "parameters": [],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/GeneratePresignedUrlDto"
                      }
                    }
                  }
                },
                "responses": {
                  "201": {
                    "description": "Presigned URL successfully generated",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/PresignedUrlResponseDto"
                        }
                      }
                    }
                  },
                  "400": {
                    "description": "Invalid file type"
                  },
                  "403": {
                    "description": "Authentication error"
                  },
                  "500": {
                    "description": "Unknown error"
                  }
                },
                "security": [
                  {
                    "basic": []
                  }
                ],
                "summary": "Generate presigned URL for file upload",
                "tags": [
                  "File Upload"
                ]
              }
            },
            "/v1/file-upload/create-asset": {
              "post": {
                "description": "\n      Creates a media library asset from a file previously uploaded via the get-presigned-url endpoint.\n\n      **Usage flow:**\n      1. Call `POST /v1/file-upload/get-presigned-url` to get a presigned URL and `filePath`\n      2. Upload the file directly to S3 using the presigned URL (PUT request)\n      3. Call this endpoint with the returned `filePath` and a `productId` to register the file as an asset\n\n      **Authentication:** Requires Basic Auth with client credentials\n    ",
                "operationId": "createAssetFromUpload",
                "parameters": [],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/CreateAssetFromUploadDto"
                      }
                    }
                  }
                },
                "responses": {
                  "201": {
                    "description": "Asset successfully created",
                    "content": {
                      "application/json": {
                        "schema": {
                          "$ref": "#/components/schemas/AssetResponseDto"
                        }
                      }
                    }
                  },
                  "400": {
                    "description": "Invalid file path or unsupported file type"
                  },
                  "403": {
                    "description": "Authentication error"
                  },
                  "500": {
                    "description": "Unknown error"
                  }
                },
                "security": [
                  {
                    "basic": []
                  }
                ],
                "summary": "Create an asset from an uploaded file",
                "tags": [
                  "File Upload"
                ]
              }
            }
          },
          "info": {
            "title": "Arcads' external API",
            "description": "",
            "version": "1.0",
            "contact": {}
          },
          "tags": [],
          "servers": [],
          "components": {
            "securitySchemes": {
              "basic": {
                "type": "http",
                "scheme": "basic"
              }
            },
            "schemas": {
              "CredentialsCreationDto": {
                "type": "object",
                "properties": {
                  "secretKey": {
                    "type": "string",
                    "description": "The ElevenLabs API key"
                  }
                },
                "required": [
                  "secretKey"
                ]
              },
              "CredentialsDto": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The id of the credentials"
                  },
                  "obfuscatedSecret": {
                    "type": "string",
                    "description": "The ElevenLabs API key"
                  },
                  "createdAt": {
                    "format": "date-time",
                    "type": "string",
                    "description": "The date the credentials were created"
                  },
                  "deletedAt": {
                    "type": "object",
                    "description": "The date the credentials were deleted"
                  }
                },
                "required": [
                  "id",
                  "obfuscatedSecret",
                  "createdAt",
                  "deletedAt"
                ]
              },
              "ScriptVideoDto": {
                "type": "object",
                "properties": {
                  "situationId": {
                    "type": "string",
                    "description": "The situation ID of the video"
                  },
                  "voiceId": {
                    "type": "string",
                    "description": "The voice ID of the video"
                  }
                },
                "required": [
                  "situationId"
                ]
              },
              "ScriptDto": {
                "type": "object",
                "properties": {
                  "folderId": {
                    "type": "string",
                    "description": "The folder ID where the script will be created. Required if projectId is not provided. If both folderId and projectId are provided, the project must belong to this folder."
                  },
                  "projectId": {
                    "type": "string",
                    "description": "The project ID where the script will be created. Required if folderId is not provided. If provided, the project must belong to the workspace."
                  },
                  "name": {
                    "type": "string",
                    "description": "The name of the script"
                  },
                  "text": {
                    "type": "string",
                    "description": "The text of the script"
                  },
                  "videos": {
                    "description": "The videos of the script",
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ScriptVideoDto"
                    }
                  },
                  "id": {
                    "type": "string",
                    "description": "The ID of the script"
                  },
                  "version": {
                    "type": "number",
                    "description": "The version of the script"
                  },
                  "isActiveVersion": {
                    "type": "boolean",
                    "description": "Whether or not this is the latest version of this script"
                  }
                },
                "required": [
                  "name",
                  "text",
                  "id",
                  "version",
                  "isActiveVersion"
                ]
              },
              "PaginatedScripts": {
                "type": "object",
                "properties": {
                  "count": {
                    "type": "number",
                    "description": "Total number of scripts matching the provided criteria"
                  },
                  "items": {
                    "description": "List of scripts matching the provided criteria and the pagination params",
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ScriptDto"
                    }
                  }
                },
                "required": [
                  "count",
                  "items"
                ]
              },
              "FolderDto": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The name of the folder"
                  },
                  "productId": {
                    "type": "string",
                    "description": "The product ID of the folder"
                  },
                  "id": {
                    "type": "string",
                    "description": "The ID of the folder"
                  },
                  "userId": {
                    "type": "string",
                    "description": "The user ID of the folder"
                  }
                },
                "required": [
                  "name",
                  "id",
                  "userId"
                ]
              },
              "FolderCreationDto": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The name of the folder"
                  },
                  "productId": {
                    "type": "string",
                    "description": "The user ID of the folder"
                  }
                },
                "required": [
                  "name"
                ]
              },
              "FolderNameUpdateDto": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The name of the folder"
                  }
                },
                "required": [
                  "name"
                ]
              },
              "CreateImageDto": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "The model used to generate the image",
                    "enum": [
                      "gpt-image",
                      "gpt-image-2",
                      "nano-banana",
                      "nano-banana-2",
                      "soul",
                      "grok_image",
                      "seedream",
                      "seedream_5_lite"
                    ],
                    "example": "gpt-image"
                  },
                  "productId": {
                    "type": "string",
                    "description": "The ID of the product",
                    "example": "40c97d04-b1b8-45fa-878d-4490a729bf5f"
                  },
                  "projectId": {
                    "type": "string",
                    "description": "The ID of the project",
                    "example": "40c97d04-b1b8-45fa-878d-4490a729bf5f"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "The prompt for the image",
                    "example": "A futuristic city skyline at sunset"
                  },
                  "aspectRatio": {
                    "type": "string",
                    "description": "The aspect ratio of the image",
                    "example": "16:9",
                    "enum": [
                      "1:1",
                      "16:9",
                      "9:16"
                    ]
                  },
                  "referenceImages": {
                    "description": "The links to reference images. Upload files via presigned URL endpoint first and pass returned file paths here.\nMax reference images per model:\n  - gpt-image: 5\n  - gpt-image-2: 5\n  - nano-banana: 14\n  - nano-banana-2: 14\n  - soul: 0\n  - grok_image: 1\n  - seedream: 4\n  - seedream_5_lite: 4",
                    "example": [
                      "/path/to/image1.jpg",
                      "/path/to/image2.jpg"
                    ],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "nbGenerations": {
                    "type": "number",
                    "description": "Number of generations for SOUL model",
                    "example": 3,
                    "minimum": 1,
                    "maximum": 10
                  },
                  "enhance": {
                    "type": "boolean",
                    "description": "When true, the prompt is enhanced by Claude before generation. Costs an additional 8 credits. Only applies to eligible asset types."
                  }
                },
                "required": [
                  "model",
                  "productId",
                  "prompt",
                  "aspectRatio"
                ]
              },
              "CreateVideoDto": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "The model used to generate the video",
                    "enum": [
                      "sora2",
                      "sora2-pro",
                      "veo31",
                      "kling-2.6",
                      "kling-3.0",
                      "grok-video",
                      "seedance",
                      "seedance-2.0",
                      "happy-horse"
                    ],
                    "example": "sora2"
                  },
                  "productId": {
                    "type": "string",
                    "description": "The ID of the product",
                    "example": "40c97d04-b1b8-45fa-878d-4490a729bf5f"
                  },
                  "projectId": {
                    "type": "string",
                    "description": "The ID of the project",
                    "example": "40c97d04-b1b8-45fa-878d-4490a729bf5f"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "The prompt for the video",
                    "example": "A futuristic city skyline at sunset"
                  },
                  "aspectRatio": {
                    "type": "string",
                    "description": "The aspect ratio of the video. Standard values: '1:1', '16:9', '9:16'. grok-video also supports 'auto'. seedance-2.0: '9:16' or '16:9' only.",
                    "example": "16:9"
                  },
                  "duration": {
                    "type": "number",
                    "description": "Duration in seconds. Model-specific: sora2/sora2-pro: 4/8/12/16/20. kling-2.6: 5/10. kling-3.0: 3-15. grok-video: 1-15. seedance: 4-12. seedance-2.0: 4-15. veo31: not applicable.",
                    "example": 5
                  },
                  "resolution": {
                    "type": "string",
                    "description": "Video resolution. Model-specific: sora2/sora2-pro: 720p/1080p. veo31: 720p/1080p/4K. grok-video: 480p/720p. seedance: 480p/720p/1080p. seedance-2.0: 480p/720p. kling models: not applicable.",
                    "example": "720p"
                  },
                  "referenceImages": {
                    "description": "The links to reference images. Upload files via presigned URL endpoint first and pass returned file paths here.\nMax reference images per model:\n  - sora2: 1\n  - sora2-pro: 1\n  - veo31: 3\n  - seedance: 1\n  - seedance-2.0: 3\n  - happy-horse: 1",
                    "example": [
                      "/path/to/image1.jpg"
                    ],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "referenceVideos": {
                    "description": "The links to reference videos (seedance-2.0 only). Upload files via presigned URL endpoint first.\nMax reference videos per model:\n  - seedance-2.0: 3",
                    "example": [
                      "/path/to/video1.mp4"
                    ],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "referenceAudios": {
                    "description": "The links to reference audios (seedance-2.0 only). Upload files via presigned URL endpoint first.\nMax reference audios per model:\n  - seedance-2.0: 3",
                    "example": [
                      "/path/to/audio1.mp3"
                    ],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "audioEnabled": {
                    "type": "boolean",
                    "description": "Enable audio output for the generated video. Only applicable for seedance-2.0.",
                    "example": true
                  },
                  "startFrame": {
                    "type": "string",
                    "description": "Path to the start frame image (presigned URL path). Supported by: veo31, kling-2.6, kling-3.0, grok-video.",
                    "example": "tmp/start-frame.jpg"
                  },
                  "endFrame": {
                    "type": "string",
                    "description": "Path to the end frame image (presigned URL path). Supported by: veo31, kling-2.6, kling-3.0, seedance.",
                    "example": "tmp/end-frame.jpg"
                  },
                  "nbGenerations": {
                    "type": "number",
                    "description": "Number of generations. Only applicable for sora2/sora2-pro models.",
                    "example": 2,
                    "minimum": 1,
                    "maximum": 10
                  },
                  "enhance": {
                    "type": "boolean",
                    "description": "When true, the prompt is enhanced by Claude before generation. Costs an additional 8 credits. Only applies to eligible asset types."
                  }
                },
                "required": [
                  "model",
                  "productId",
                  "prompt"
                ]
              },
              "PresetTypeDto": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "The preset type slug",
                    "enum": [
                      "camera-movement",
                      "fashion-tryon",
                      "gameplay-ad",
                      "gestures",
                      "product-showcase",
                      "showyourapp",
                      "unboxing-pov"
                    ],
                    "example": "gestures"
                  },
                  "name": {
                    "type": "string",
                    "description": "Human-readable name",
                    "example": "Gestures"
                  },
                  "description": {
                    "type": "string",
                    "description": "Description of the preset type"
                  }
                },
                "required": [
                  "type",
                  "name",
                  "description"
                ]
              },
              "EmbeddedActorDto": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The actor's ID"
                  },
                  "name": {
                    "type": "string",
                    "description": "The actor's display name",
                    "example": "Sarah"
                  },
                  "gender": {
                    "type": "string",
                    "description": "The actor's gender",
                    "enum": [
                      "Female",
                      "Male"
                    ],
                    "example": "Female"
                  },
                  "age": {
                    "type": "string",
                    "description": "The actor's age bracket",
                    "enum": [
                      "Adult",
                      "Senior",
                      "Young Adult"
                    ],
                    "example": "Adult"
                  },
                  "skinTone": {
                    "type": "string",
                    "description": "The actor's canonical skin-tone slug",
                    "enum": [
                      "skin100",
                      "skin200",
                      "skin300",
                      "skin400",
                      "skin500",
                      "skin600"
                    ],
                    "example": "skin300"
                  },
                  "skinToneHex": {
                    "type": "string",
                    "description": "Hex color matching the actor's skinTone, for rendering swatches identically to the Arcads UI",
                    "example": "#CFA07C"
                  },
                  "freeSpeech": {
                    "type": "boolean",
                    "description": "Whether the actor supports free-speech generation"
                  },
                  "imageUrl": {
                    "type": "string",
                    "description": "Signed URL to the actor's headshot image. Empty string if no headshot is available."
                  }
                },
                "required": [
                  "id",
                  "name",
                  "gender",
                  "age",
                  "skinTone",
                  "skinToneHex",
                  "freeSpeech",
                  "imageUrl"
                ]
              },
              "PresetTemplateDto": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The template ID (use as situationId in the generate endpoint)",
                    "example": "40c97d04-b1b8-45fa-878d-4490a729bf5f"
                  },
                  "actorId": {
                    "type": "string",
                    "description": "The actor ID of the situation"
                  },
                  "actor": {
                    "description": "Actor associated with this situation. Null for situations without an actor (e.g. B-roll, Sora-2).",
                    "nullable": true,
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/EmbeddedActorDto"
                      }
                    ]
                  },
                  "workspaceId": {
                    "type": "string",
                    "description": "The workspace ID of the situation",
                    "nullable": true
                  },
                  "previewUrl": {
                    "type": "string",
                    "description": "The video's URL"
                  },
                  "imageUrl": {
                    "type": "string",
                    "description": "The snapshot image URL"
                  },
                  "tags": {
                    "description": "Free-form tags describing what is shown in the situation (e.g. setting, scenario, mood). Useful for choosing the right situation to remix for a given product.",
                    "example": [
                      "kitchen",
                      "sitting",
                      "casual"
                    ],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "emotions": {
                    "description": "Emotions conveyed by the actor in the situation.",
                    "example": [
                      "happy",
                      "curious"
                    ],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "accessories": {
                    "description": "Accessories visible in the situation.",
                    "example": [
                      "glasses",
                      "hat"
                    ],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "cameraAngle": {
                    "type": "string",
                    "description": "Camera angle of the situation. Null when the situation has no specific angle.",
                    "nullable": true,
                    "enum": [
                      "front",
                      "close_up",
                      "low_angle",
                      "depth"
                    ]
                  },
                  "talkingActorEnabled": {
                    "type": "boolean",
                    "description": "Whether this situation is a standard talking-actor situation (lip-synced UGC). Mutually exclusive with the other content-type flags below."
                  },
                  "showYourAppEnabled": {
                    "type": "boolean",
                    "description": "Whether this situation is a \"show your app\" situation (actor presenting an on-screen app)."
                  },
                  "unboxingPovEnabled": {
                    "type": "boolean",
                    "description": "Whether this situation is an unboxing POV situation."
                  },
                  "brollSora2Enabled": {
                    "type": "boolean",
                    "description": "Whether this situation is a Sora-2 B-roll situation."
                  },
                  "brollSora2OpenaiVideoId": {
                    "type": "object",
                    "description": "The OpenAI Sora-2 video ID used as the source for this B-roll situation. Null for situations that are not Sora-2 B-roll.",
                    "nullable": true
                  },
                  "fashionTryOnEnabled": {
                    "type": "boolean",
                    "description": "Whether this situation is a fashion try-on situation."
                  },
                  "productShowcaseEnabled": {
                    "type": "boolean",
                    "description": "Whether this situation is a product-showcase situation."
                  },
                  "gesturesEnabled": {
                    "type": "boolean",
                    "description": "Whether this situation is a gestures situation."
                  },
                  "cameraMovementEnabled": {
                    "type": "boolean",
                    "description": "Whether this situation is a camera-movement situation."
                  },
                  "cameraMovementMotionId": {
                    "type": "object",
                    "description": "The motion ID used for this camera-movement situation. Null for situations that are not camera-movement.",
                    "nullable": true
                  }
                },
                "required": [
                  "id",
                  "previewUrl",
                  "imageUrl",
                  "tags",
                  "emotions",
                  "accessories",
                  "talkingActorEnabled",
                  "showYourAppEnabled",
