                  "productId",
                  "prompt",
                  "aspectRatio"
                ]
              },
              "SceneVideoAssetDataDto": {
                "type": "object",
                "properties": {
                  "script": {
                    "type": "string",
                    "description": "The script used for video generation"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "The prompt used for video generation"
                  },
                  "contextScript": {
                    "type": "string",
                    "description": "The context script of the video"
                  },
                  "contextPrompt": {
                    "type": "string",
                    "description": "The context prompt of the video"
                  },
                  "aspectRatio": {
                    "type": "string",
                    "description": "The aspect ratio of the video",
                    "enum": [
                      "1:1",
                      "16:9",
                      "9:16"
                    ]
                  },
                  "hasInputImage": {
                    "type": "boolean",
                    "description": "Whether the video has an input image"
                  },
                  "hasStartFrame": {
                    "type": "boolean",
                    "description": "Whether the video has a start frame"
                  },
                  "nbGenerations": {
                    "type": "number",
                    "description": "Number of generations"
                  },
                  "refImage": {
                    "type": "string",
                    "description": "Reference image URL"
                  },
                  "startFrame": {
                    "type": "string",
                    "description": "Start frame URL"
                  }
                },
                "required": [
                  "prompt",
                  "aspectRatio"
                ]
              },
              "SceneVideoAssetResponseDto": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The unique identifier of the video asset"
                  },
                  "productId": {
                    "type": "string",
                    "description": "The ID of the product this video asset belongs to"
                  },
                  "type": {
                    "type": "string",
                    "description": "The type of video asset",
                    "enum": [
                      "actor_image",
                      "actor_image_suggestions",
                      "ai_actor",
                      "audio_driven",
                      "camera_angle",
                      "camera_movement",
                      "captions",
                      "styled_subtitles",
                      "change_voice",
                      "extend_video",
                      "extend_sora2",
                      "extract_frame",
                      "extract_audio",
                      "change_speed_video",
                      "change_speed_audio",
                      "isolate_voice",
                      "speech_to_speech",
                      "text_to_speech",
                      "mute_video",
                      "fashion_tryon",
                      "gameplay_ad",
                      "gestures",
                      "gpt-image",
                      "gpt-image-2",
                      "grok_image",
                      "grok_imagine_15",
                      "grok_video",
                      "grok_video_edit",
                      "happy_horse",
                      "hook_repurposed",
                      "image-background-removed",
                      "kling_26",
                      "kling_30",
                      "kling_30_4k",
                      "kling-animate",
                      "kling30-animate",
                      "nano-banana",
                      "nano-banana-2",
                      "omnihuman",
                      "product_showcase",
                      "seedance",
                      "seedance_20",
                      "seedream",
                      "seedream_5_lite",
                      "showyourapp",
                      "skin_enhanced_image",
                      "sora2",
                      "soul",
                      "stitch",
                      "transcribe",
                      "transcribe_audio",
                      "translate_video",
                      "unboxing_pov",
                      "uploaded_audio",
                      "uploaded_document",
                      "uploaded_image",
                      "uploaded_video",
                      "upscaled_image",
                      "upscaled_video",
                      "veo31",
                      "video-background-removed",
                      "video_editor",
                      "wan22_animate",
                      "replace_actor",
                      "rendered_video",
                      "ai_video_editing",
                      "rendered_image",
                      "prompt_builder",
                      "prompt_enhancer",
                      "llm",
                      "workflow_text_split",
                      "actor_motion",
                      "scene",
                      "b_roll"
                    ],
                    "example": "scene"
                  },
                  "url": {
                    "type": "string",
                    "description": "The URL of the generated video"
                  },
                  "sdUrl": {
                    "type": "string",
                    "description": "The URL of the standard definition video"
                  },
                  "thumbnailUrl": {
                    "type": "string",
                    "description": "The URL of the video thumbnail"
                  },
                  "status": {
                    "type": "string",
                    "description": "The current status of the video asset",
                    "enum": [
                      "created",
                      "pending",
                      "generated",
                      "failed",
                      "uploaded"
                    ]
                  },
                  "data": {
                    "description": "The video asset data",
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/SceneVideoAssetDataDto"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "productId",
                  "type",
                  "status",
                  "data"
                ]
              },
              "VoiceDto": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The ID of the voice"
                  },
                  "workspaceId": {
                    "type": "object",
                    "description": "The workspace ID of the voice"
                  },
                  "name": {
                    "type": "string",
                    "description": "The name of the voice"
                  },
                  "gender": {
                    "type": "object",
                    "description": "The gender of the voice (optional for imported ElevenLabs voices)"
                  },
                  "age": {
                    "type": "object",
                    "description": "The age of the voice (optional for imported ElevenLabs voices)"
                  },
                  "accent": {
                    "type": "string",
                    "description": "The accent of the voice (optional for imported ElevenLabs voices)"
                  },
                  "language": {
                    "type": "object",
                    "description": "The language of the voice"
                  },
                  "descriptive": {
                    "type": "string",
                    "description": "The description of the voice"
                  },
                  "audioUrl": {
                    "type": "string",
                    "description": "The voice's audio URL"
                  },
                  "createdAt": {
                    "type": "string",
                    "description": "The date when the voice was created"
                  }
                },
                "required": [
                  "id",
                  "workspaceId",
                  "name",
                  "gender",
                  "age",
                  "accent",
                  "language",
                  "descriptive",
                  "audioUrl",
                  "createdAt"
                ]
              },
              "PaginatedVoices": {
                "type": "object",
                "properties": {
                  "count": {
                    "type": "number",
                    "description": "Total number of situations matching the provided criteria"
                  },
                  "items": {
                    "description": "List of situations matching the provided criteria and the pagination params",
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/VoiceDto"
                    }
                  }
                },
                "required": [
                  "count",
                  "items"
                ]
              },
              "StartSora2Dto": {
                "type": "object",
                "properties": {
                  "productId": {
                    "type": "string",
                    "description": "The ID of the product",
                    "example": "40c97d04-b1b8-45fa-878d-4490a729bf5f"
                  },
                  "projectId": {
                    "type": "string",
                    "description": "The ID of the project",
                    "example": "40c97d04-b1b8-45fa-878d-4490a729bf5f"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "The prompt for the video",
                    "example": "A beautiful landscape with mountains and a lake at sunset"
                  },
                  "aspectRatio": {
                    "type": "string",
                    "description": "The aspect ratio of the video",
                    "example": "16:9",
                    "enum": [
                      "1:1",
                      "16:9",
                      "9:16"
                    ]
                  },
                  "duration": {
                    "type": "number",
                    "description": "The duration of the video",
                    "example": 4,
                    "enum": [
                      4,
                      8,
                      12,
                      16,
                      20
                    ]
                  },
                  "refImageFilePath": {
                    "type": "string",
                    "description": "S3 file path returned by `POST /v1/file-upload/get-presigned-url` after uploading the image with the presigned URL. Must be under `external-api-temp-uploads/`. If both this and `refImageAsBase64` are set, this field takes precedence.",
                    "example": "external-api-temp-uploads/123e4567-e89b-12d3-a456-426614174000.jpg"
                  },
                  "refImageAsBase64": {
                    "type": "string",
                    "description": "Reference image as a data URL (base64). Ignored when `refImageFilePath` is provided.",
                    "example": "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQ..."
                  },
                  "resolution": {
                    "type": "string",
                    "description": "The resolution of the video",
                    "example": "720p",
                    "enum": [
                      "720p",
                      "1080p"
                    ]
                  },
                  "model": {
                    "type": "string",
                    "description": "The model to use for the video",
                    "example": "sora2",
                    "enum": [
                      "sora2",
                      "sora2_pro"
                    ]
                  }
                },
                "required": [
                  "productId",
                  "prompt",
                  "aspectRatio",
                  "duration"
                ]
              },
              "RemixSora2Dto": {
                "type": "object",
                "properties": {
                  "productId": {
                    "type": "string",
                    "description": "The ID of the product",
                    "example": "40c97d04-b1b8-45fa-878d-4490a729bf5f"
                  },
                  "projectId": {
                    "type": "string",
                    "description": "The ID of the project",
                    "example": "40c97d04-b1b8-45fa-878d-4490a729bf5f"
                  },
                  "sourceVideoAssetId": {
                    "type": "string",
                    "description": "The ID of the source video asset",
                    "example": "40c97d04-b1b8-45fa-878d-4490a729bf5f"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "The prompt for the video",
                    "example": "A beautiful landscape with mountains and a lake at sunset"
                  }
                },
                "required": [
                  "productId",
                  "sourceVideoAssetId",
                  "prompt"
                ]
              },
              "ActorInputDto": {
                "type": "object",
                "properties": {
                  "situationId": {
                    "type": "string",
                    "description": "The situation ID of the actor",
                    "example": "40c97d04-b1b8-45fa-878d-4490a729bf5f"
                  },
                  "voiceId": {
                    "type": "string",
                    "description": "The voice ID of the actor. Opaque string - supports both internal UUIDs and external provider IDs (e.g. ElevenLabs).",
                    "example": "elevenlabs-voice-id"
                  }
                },
                "required": [
                  "situationId"
                ]
              },
              "GenerateTalkingActorsDto": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "The model used to generate talking actors",
                    "enum": [
                      "arcads_1.0",
                      "audio_driven",
                      "omnihuman"
                    ],
                    "example": "arcads_1.0"
                  },
                  "productId": {
                    "type": "string",
                    "description": "The ID of the product",
                    "example": "40c97d04-b1b8-45fa-878d-4490a729bf5f"
                  },
                  "projectId": {
                    "type": "string",
                    "description": "The ID of the project",
                    "example": "40c97d04-b1b8-45fa-878d-4490a729bf5f"
                  },
                  "script": {
                    "type": "string",
                    "description": "The script for the talking actors. Required if referenceAudios is not provided.",
                    "example": "Hello, this is a test script."
                  },
                  "referenceAudios": {
                    "description": "Reference audio files. Required if script is not provided. Max 1 file.",
                    "example": [
                      "/path/to/audio.mp3"
                    ],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "actors": {
                    "description": "The actors to generate",
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ActorInputDto"
                    }
                  },
                  "autoAddScriptEmotion": {
                    "type": "boolean",
                    "description": "Whether to automatically add script emotion",
                    "example": false
                  }
                },
                "required": [
                  "model",
                  "productId",
                  "actors"
                ]
              },
              "GenerationResultItemDto": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The ID of the generated asset",
                    "example": "40c97d04-b1b8-45fa-878d-4490a729bf5f"
                  },
                  "model": {
                    "type": "string",
                    "description": "The model used for generation",
                    "enum": [
                      "arcads_1.0",
                      "audio_driven",
                      "omnihuman"
                    ],
                    "example": "arcads_1.0"
                  },
                  "status": {
                    "type": "string",
                    "description": "The status of the generation",
                    "enum": [
                      "processing",
                      "completed",
                      "failed"
                    ],
                    "example": "processing"
                  }
                },
                "required": [
                  "id",
                  "model",
                  "status"
                ]
              },
              "TalkingActorStatusDto": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The ID of the talking actor asset",
                    "example": "40c97d04-b1b8-45fa-878d-4490a729bf5f"
                  },
                  "model": {
                    "type": "string",
                    "description": "The model used for generation",
                    "enum": [
                      "arcads_1.0",
                      "audio_driven",
                      "omnihuman"
                    ],
                    "example": "arcads_1.0"
                  },
                  "status": {
                    "type": "string",
                    "description": "The status of the generation",
                    "enum": [
                      "processing",
                      "completed",
                      "failed"
                    ],
                    "example": "processing"
                  },
                  "createdAt": {
                    "format": "date-time",
                    "type": "string",
                    "description": "The creation timestamp",
                    "example": "2024-01-01T00:00:00Z"
                  },
                  "updatedAt": {
                    "format": "date-time",
                    "type": "string",
                    "description": "The last update timestamp",
                    "example": "2024-01-01T00:00:00Z"
                  },
                  "error": {
                    "type": "string",
                    "description": "Error message if generation failed",
                    "example": "Generation failed due to invalid input"
                  }
                },
                "required": [
                  "id",
                  "model",
                  "status",
                  "createdAt",
                  "updatedAt"
                ]
              },
              "StartVeo31Dto": {
                "type": "object",
                "properties": {
                  "productId": {
                    "type": "string",
                    "description": "The ID of the product",
                    "example": "40c97d04-b1b8-45fa-878d-4490a729bf5f"
                  },
                  "projectId": {
                    "type": "string",
                    "description": "The ID of the project",
                    "example": "40c97d04-b1b8-45fa-878d-4490a729bf5f"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "The prompt for the video",
                    "example": "A beautiful landscape with mountains and a lake at sunset"
                  },
                  "resolution": {
                    "type": "string",
                    "description": "The resolution of the video",
                    "example": "1080p",
                    "enum": [
                      "480p",
                      "720p",
                      "1080p",
                      "4K"
                    ]
                  },
                  "aspectRatio": {
                    "type": "string",
                    "description": "The aspect ratio of the video",
                    "example": "16:9",
                    "enum": [
                      "1:1",
                      "16:9",
                      "9:16"
                    ]
                  },
                  "referenceImages": {
                    "description": "The links to the reference images. You need to call GET v1/file-upload/get-presigned-url to get an upload presigned URL and a filePath. Then upload the images to S3 using the presigned URL. Put the filePath in the referenceImages array.",
                    "example": [
                      "/path/to/image1.jpg",
                      "/path/to/image2.jpg"
                    ],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "startFrame": {
                    "type": "string",
                    "description": "The link to the start frame. Start frame can not be used with reference images. You need to call GET v1/file-upload/get-presigned-url to get an upload presigned URL and a filePath. Then upload the image to S3 using the presigned URL. Put the filePath in the startFrame variable.",
                    "example": "/path/to/start-frame.jpg"
                  },
                  "endFrame": {
                    "type": "string",
                    "description": "The link to the end frame. End frame can only be used if start frame is provided.",
                    "example": "/path/to/end-frame.jpg"
                  }
                },
                "required": [
                  "productId",
                  "prompt",
                  "resolution",
                  "aspectRatio"
                ]
              },
              "GeneratePresignedUrlDto": {
                "type": "object",
                "properties": {
                  "fileType": {
                    "type": "string",
                    "description": "The MIME type of the file to upload",
                    "example": "image/jpeg",
                    "enum": [
                      "image/jpeg",
                      "image/jpg",
                      "image/png",
                      "image/gif",
                      "image/webp",
                      "image/heic",
                      "image/heif",
                      "video/mp4",
                      "video/quicktime",
                      "video/avi",
                      "video/mov",
                      "video/wmv",
                      "video/webm",
                      "audio/mp3",
                      "audio/mp4",
                      "audio/wav",
                      "audio/m4a",
                      "audio/x-m4a",
                      "audio/aac",
                      "audio/ogg",
                      "audio/flac",
                      "audio/webm",
                      "audio/mpeg",
                      "audio/opus",
                      "application/pdf",
                      "text/plain",
                      "text/html",
                      "text/markdown",
                      "text/x-markdown",
                      "text/md",
                      "text/csv",
                      "text/x-csv",
                      "application/csv",
                      "application/x-csv",
                      "text/comma-separated-values",
                      "text/x-comma-separated-values",
                      "application/json",
                      "application/msword",
                      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                      "application/vnd.ms-excel",
                      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                      "application/vnd.apple.pages",
                      "application/vnd.apple.numbers",
                      "application/vnd.google-apps.document",
                      "application/vnd.google-apps.spreadsheet",
                      "application/vnd.google-apps.presentation",
                      "application/vnd.google-apps.drawing",
                      "application/x-iwork-pages-sffpages",
                      "application/x-iwork-numbers-sffnumbers"
                    ]
                  }
                },
                "required": [
                  "fileType"
                ]
              },
              "PresignedUrlResponseDto": {
                "type": "object",
                "properties": {
                  "presignedUrl": {
                    "type": "string",
                    "description": "The presigned URL for uploading the file directly to S3",
                    "example": "https://bucket.s3.amazonaws.com/uploads/workspace-id/image/jpeg/file-id.jpg?X-Amz-Algorithm=..."
                  },
                  "filePath": {
                    "type": "string",
                    "description": "The S3 file path where the file will be stored",
                    "example": "uploads/workspace-id/image/jpeg/file-id.jpg"
                  },
                  "fileId": {
                    "type": "string",
                    "description": "The unique file ID generated for this upload",
                    "example": "123e4567-e89b-12d3-a456-426614174000"
                  },
                  "expiresIn": {
                    "type": "number",
                    "description": "The expiration time of the presigned URL in seconds",
                    "example": 600
                  },
                  "maxFileSize": {
                    "type": "number",
                    "description": "Maximum allowed file size in bytes",
                    "example": 10485760
                  },
                  "maxDuration": {
                    "type": "number",
                    "description": "Maximum allowed video duration in seconds (for video uploads)",
                    "example": 30
                  }
                },
                "required": [
                  "presignedUrl",
                  "filePath",
                  "fileId",
                  "expiresIn"
                ]
              },
              "CreateAssetFromUploadDto": {
                "type": "object",
                "properties": {
                  "filePath": {
                    "type": "string",
                    "description": "The S3 file path returned by the get-presigned-url endpoint after uploading the file",
                    "example": "external-api-temp-uploads/123e4567-e89b-12d3-a456-426614174000.jpg"
                  },
                  "productId": {
                    "type": "string",
                    "description": "The product ID to associate the asset with",
                    "example": "b972ffe0-3364-46ad-922e-211df4f1d441"
                  },
                  "name": {
                    "type": "string",
                    "description": "Optional name for the asset"
                  }
                },
                "required": [
                  "filePath",
                  "productId"
                ]
              }
            }
          }
        }
      })
    </script>
  </body>
</html>