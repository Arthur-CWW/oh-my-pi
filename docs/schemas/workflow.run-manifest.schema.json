{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-workflows.local/schemas/workflow.run-manifest.schema.json",
  "title": "Pi Video Pipeline Run Manifest",
  "description": "v1alpha1 schema for immutable JSON manifests emitted by executed video pipeline runs.",
  "type": "object",
  "required": ["schemaVersion", "recipeId", "runId", "startedAt", "status", "stages", "artifacts", "errors"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "pi.workflow.run/v1alpha1"
    },
    "recipeId": { "$ref": "#/$defs/slug" },
    "runId": { "$ref": "#/$defs/runId" },
    "startedAt": { "$ref": "#/$defs/dateTime" },
    "finishedAt": {
      "oneOf": [
        { "$ref": "#/$defs/dateTime" },
        { "type": "null" }
      ]
    },
    "status": { "$ref": "#/$defs/runStatus" },
    "recipeSha256": { "$ref": "#/$defs/sha256" },
    "recipeSnapshotPath": { "type": "string", "minLength": 1 },
    "policyResolved": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "providers": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/providerId" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "#/$defs/jsonValue" },
        "properties": {
          "provider": { "$ref": "#/$defs/providerId" },
          "model": { "type": "string" },
          "version": { "type": "string" },
          "sessionRef": { "type": "string" }
        }
      }
    },
    "stages": {
      "type": "array",
      "items": { "$ref": "#/$defs/stageRun" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/runError" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "providerId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "stageKind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "uri": {
      "type": "string",
      "pattern": "^(asset|file|artifact|https|x-tweet)://.+$"
    },
    "artifactRef": {
      "type": "string",
      "pattern": "^artifact://[A-Za-z][A-Za-z0-9_-]*/[A-Za-z][A-Za-z0-9_-]*$"
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "runStatus": {
      "type": "string",
      "enum": ["planned", "running", "succeeded", "failed", "canceled", "partial"]
    },
    "stageStatus": {
      "type": "string",
      "enum": ["pending", "running", "skipped", "succeeded", "failed", "canceled"]
    },
    "stageRun": {
      "type": "object",
      "required": ["id", "kind", "provider", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/stageKind" },
        "provider": { "$ref": "#/$defs/providerId" },
        "status": { "$ref": "#/$defs/stageStatus" },
        "startedAt": {
          "oneOf": [
            { "$ref": "#/$defs/dateTime" },
            { "type": "null" }
          ]
        },
        "finishedAt": {
          "oneOf": [
            { "$ref": "#/$defs/dateTime" },
            { "type": "null" }
          ]
        },
        "needs": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        },
        "inputsResolved": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        },
        "outputs": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": {
            "anyOf": [
              { "$ref": "#/$defs/artifactRef" },
              { "$ref": "#/$defs/jsonValue" }
            ]
          }
        },
        "cost": { "$ref": "#/$defs/cost" },
        "attempts": { "type": "integer", "minimum": 0 },
        "logs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "providerRawPath": { "type": "string" },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/runError" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["id", "kind", "createdByStage"],
      "additionalProperties": false,
      "anyOf": [
        { "required": ["path"] },
        { "required": ["uri"] }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "type": "string",
          "enum": [
            "image",
            "video",
            "audio",
            "subtitle",
            "text",
            "json",
            "mask",
            "caption-style",
            "scene-template",
            "format-template",
            "other"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "uri": { "$ref": "#/$defs/uri" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mimeType": { "type": "string", "minLength": 1 },
        "createdByStage": { "$ref": "#/$defs/identifier" },
        "durationSec": { "type": "number", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "hasAlpha": { "type": "boolean" },
        "loopable": { "type": "boolean" },
        "assetCatalogId": { "type": "string" },
        "meta": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" },
      "properties": {
        "currency": { "type": "string", "minLength": 1 },
        "estimated": { "type": "number", "minimum": 0 },
        "actual": { "type": "number", "minimum": 0 },
        "units": { "type": "string" }
      }
    },
    "runError": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "stageId": { "$ref": "#/$defs/identifier" },
        "provider": { "$ref": "#/$defs/providerId" },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "at": { "$ref": "#/$defs/dateTime" },
        "details": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    }
  }
}
