{
  "name": "@wirebabel/pi-web-access",
  "version": "0.10.3",
  "description": "Web search, content fetching, and YouTube transcripts for Pi coding agent",
  "type": "module",
  "keywords": ["pi-package", "pi", "extension", "web-search", "fetch"],
  "author": "wirebabel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arthur-CWW/pi-web-access.git"
  },
  "bin": {
    "pi-web-search": "./src/cli.ts",
    "pi-chatgpt": "./src/chatgpt-cli.ts",
    "pi-llm-browser": "./src/frontend-browser-cli.ts"
  },
  "files": ["src", "skills", "README.md", "CHANGELOG.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "bun test ./test ./src",
    "check": "bun run typecheck && bun run test",
    "search": "bun run src/cli.ts",
    "chatgpt": "bun run src/chatgpt-cli.ts",
    "llm-browser": "bun run src/frontend-browser-cli.ts",
    "kagi-search": "bun run src/cli.ts --provider kagi"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "effect": "^4.0.0-beta.71",
    "linkedom": "^0.16.0",
    "puppeteer-core": "^24.26.1",
    "turndown": "^7.2.0"
  },
  "pi": {
    "extensions": ["./src/index.ts"],
    "skills": ["./skills"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.75.5",
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@sinclair/typebox": "^0.34.48",
    "@types/node": "^25.2.3",
    "@types/turndown": "^5.0.6",
    "bun-types": "^1.3.9",
    "typescript": "^5.9.3"
  }
}
