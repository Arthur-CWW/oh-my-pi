{
  "name": "pi-workflows",
  "version": "0.1.0",
  "private": true,
  "description": "Pi extensions, skills, and workflows for web access and shortform video pipelines",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "keywords": ["pi-package", "pi", "workflows", "skills"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arthur-CWW/pi-workflows.git"
  },
  "scripts": {
    "typecheck": "cd packages/web-access && bun run typecheck && cd ../twitter-archive && bun run typecheck",
    "test": "cd packages/web-access && bun run test",
    "check": "bun run typecheck && bun run test",
    "web-access:smoke": "cd packages/web-access && bun run scripts/smoke.ts",
    "web-access:help": "pi -e ./packages/web-access/src/index.ts --help",
    "twitter-archive:typecheck": "cd packages/twitter-archive && bun run typecheck"
  },
  "pi": {
    "extensions": ["./packages/web-access/src/index.ts"],
    "skills": ["./packages/web-access/skills"]
  }
}
