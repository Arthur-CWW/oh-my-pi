{
	"name": "pi-web-access",
	"version": "0.10.2",
	"description": "Web search, URL fetching, GitHub repo cloning, PDF extraction, YouTube video understanding, and local video analysis for Pi coding agent",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"extension",
		"web-search",
		"perplexity",
		"fetch",
		"scraping"
	],
	"author": "Nico Bailon",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nicobailon/pi-web-access.git"
	},
	"bugs": {
		"url": "https://github.com/nicobailon/pi-web-access/issues"
	},
	"homepage": "https://github.com/nicobailon/pi-web-access#readme",
	"scripts": {
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
		"check": "bun run typecheck && bun run lint && bun run format:check",
		"test": "bun test tests",
		"test:e2e:cookies": "bun scripts/e2e-chrome-cookies.ts",
		"test:e2e:search:gemini": "bun scripts/e2e-search-gemini.ts",
		"test:e2e:effect:help": "pi --no-extensions -e ./src/effect/index.ts --help",
		"test:e2e:cookies:effect": "bun scripts/e2e-chrome-cookies-effect.ts",
		"test:e2e:search:gemini:effect": "bun scripts/e2e-search-gemini-effect.ts"
	},
	"dependencies": {
		"@effect/platform": "^0.94.5",
		"@effect/platform-node": "^0.104.1",
		"@effect/schema": "^0.75.5",
		"@mozilla/readability": "^0.5.0",
		"effect": "^3.19.18",
		"linkedom": "^0.16.0",
		"p-limit": "^6.1.0",
		"turndown": "^7.2.0",
		"unpdf": "^1.4.0"
	},
	"pi": {
		"extensions": [
			"./src/old/index.ts"
		],
		"skills": [
			"./skills"
		],
		"video": "https://github.com/nicobailon/pi-web-access/raw/refs/heads/main/pi-web-fetch-demo.mp4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.2",
		"@mariozechner/pi-ai": "^0.53.0",
		"@mariozechner/pi-coding-agent": "^0.53.0",
		"@mariozechner/pi-tui": "^0.53.0",
		"@sinclair/typebox": "^0.34.48",
		"@types/node": "^25.2.3",
		"@types/turndown": "^5.0.6",
		"bun-types": "^1.3.9",
		"typescript": "^5.9.3"
	}
}
