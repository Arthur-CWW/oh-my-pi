{
  "name": "agents",
  "version": "0.1.0",
  "private": true,
  "description": "Agent extensions, skills, tools, and local-first AI workflows",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "keywords": ["pi-package", "pi", "workflows", "skills"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arthur-CWW/agents.git"
  },
  "scripts": {
    "typecheck": "cd packages/web-access && bun run typecheck && cd ../mermaid-preview && bun run typecheck && cd ../twitter-archive && bun run typecheck && cd ../jimeng-client && bun run typecheck && cd ../dynamic-workflows && bun run typecheck && cd ../ugc-cli && bun run typecheck && cd ../market-lab && bun run typecheck && cd ../proxy-lab && bun run typecheck && cd ../library-assistant && bun run typecheck && cd ../bench-harness && bun run typecheck && cd ../../apps/slotok-workbench && bun run typecheck",
    "test": "cd packages/web-access && bun run test && cd ../mermaid-preview && bun run test && cd ../twitter-archive && bun run test && cd ../jimeng-client && bun run test && cd ../dynamic-workflows && bun run test && cd ../ugc-cli && bun run test && cd ../market-lab && bun run test && cd ../proxy-lab && bun run test && cd ../library-assistant && bun run test && cd ../bench-harness && bun run test && cd ../../apps/slotok-workbench && bun run test",
    "check": "bun run typecheck && bun run test && bun run lint",
    "lint": "bun run lint:unsafe-types && bun run lint:ast-grep && bun run lint:ast-grep:tests",
    "lint:ast-grep": "bun run scripts/ast-grep.boundary.ts scan --config sgconfig.yml --off=no-unsafe-any-unknown-ts --off=no-unsafe-any-python --report-style=medium",
    "lint:ast-grep:tests": "bun run scripts/check-ast-grep-tests.boundary.ts && bun run lint:unsafe-types:rules",
    "lint:unsafe-types": "bun run scripts/lint-unsafe-types.boundary.ts",
    "lint:unsafe-types:update-baseline": "bun run scripts/lint-unsafe-types.boundary.ts --update",
    "lint:unsafe-types:strict": "bun run scripts/lint-unsafe-types.boundary.ts --strict",
    "lint:unsafe-types:rules": "bun run scripts/ast-grep.boundary.ts test --config sgconfig.yml --skip-snapshot-tests",
    "slotok:build": "cd apps/slotok-workbench && bun run build",
    "slotok:daemon": "cd apps/slotok-workbench && bun run dev:daemon",
    "slotok:smoke": "cd apps/slotok-workbench && bun run smoke:daemon",
    "slotok:visual:qa": "cd apps/slotok-workbench && bun run visual:qa",
    "slotok:test": "cd apps/slotok-workbench && bun run test",
    "slotok:test:update": "cd apps/slotok-workbench && bun run test:update",
    "slotok:typecheck": "cd apps/slotok-workbench && bun run typecheck",
    "ugc": "bun packages/ugc-cli/src/cli.ts",
    "ugc:typecheck": "cd packages/ugc-cli && bun run typecheck",
    "ugc:test": "cd packages/ugc-cli && bun run test",
    "web-access:smoke": "cd packages/web-access && bun run scripts/smoke.ts",
    "web-access:help": "pi -e ./packages/web-access/src/index.ts --help",
    "browser-use:helium": "bash scripts/browser-use-helium-background.sh",
    "cockpit": "bun packages/web-access/src/agent-cockpit-cli.ts",
    "twitter-archive:typecheck": "cd packages/twitter-archive && bun run typecheck",
    "twitter-archive:test": "cd packages/twitter-archive && bun run test",
    "jimeng:typecheck": "cd packages/jimeng-client && bun run typecheck",
    "jimeng:test": "cd packages/jimeng-client && bun run test",
    "jimeng:cli": "bun packages/jimeng-client/src/cli.ts",
    "jimeng:dreamina": "bun packages/jimeng-client/src/dreamina-compatible-cli.ts",
    "jimeng:browser-proxy": "bun packages/jimeng-client/src/browser-proxy-cli.ts",
    "jimeng:artifacts": "bun packages/jimeng-client/src/artifact-dashboard.ts",
    "jimeng:dashboard": "bun packages/jimeng-client/src/artifact-dashboard.ts serve --db data/jimeng-lab/artifact-log.sqlite --root . --port 4188",
    "jimeng:packet:next": "bun packages/jimeng-client/src/artifact-dashboard.ts packet next --db data/jimeng-lab/artifact-log.sqlite",
    "jimeng:packet:get": "bun packages/jimeng-client/src/artifact-dashboard.ts packet get --db data/jimeng-lab/artifact-log.sqlite",
    "jimeng:coverage": "bun packages/jimeng-client/src/browser-proxy-cli.ts triage-coverage --decisions keep --outDir data/jimeng-lab/latest-keep-coverage",
    "jimeng:proof-report": "bun packages/jimeng-client/src/browser-proxy-cli.ts proof-report",
    "dynamic-workflows:typecheck": "cd packages/dynamic-workflows && bun run typecheck",
    "dynamic-workflows:test": "cd packages/dynamic-workflows && bun run test",
    "market-lab:typecheck": "cd packages/market-lab && bun run typecheck",
    "market-lab:test": "cd packages/market-lab && bun run test",
    "proxy-lab:typecheck": "cd packages/proxy-lab && bun run typecheck",
    "proxy-lab:test": "cd packages/proxy-lab && bun run test",
    "library-assistant:typecheck": "cd packages/library-assistant && bun run typecheck",
    "library-assistant:test": "cd packages/library-assistant && bun run test",
    "bench-harness:typecheck": "cd packages/bench-harness && bun run typecheck",
    "bench-harness:test": "cd packages/bench-harness && bun run test"
  },
  "pi": {
    "extensions": ["./packages/web-access/src/index.ts", "./packages/mermaid-preview/src/index.ts", "./packages/browser-use/index.ts"],
    "skills": [
      "./packages/web-access/skills/background-browser-automation",
      "./packages/web-access/skills/jimeng-browser-proxy",
      "./packages/web-access/skills/librarian",
      "./packages/web-access/skills/llm-frontend-browser",
      "./packages/web-access/skills/macos-computer-use",
      "./packages/web-access/skills/proof-of-work-qa",
      "./packages/web-access/skills/rubber-duck-adversarial",
      "./packages/web-access/skills/source-archive"
    ],
    "prompts": ["./packages/dynamic-workflows/prompts"]
  },
  "devDependencies": {
    "@ast-grep/cli": "0.42.2"
  }
}
