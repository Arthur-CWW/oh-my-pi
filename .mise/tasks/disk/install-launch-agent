#!/usr/bin/env bash
#MISE description="Install and bootstrap the reviewed disk-pressure user LaunchAgent"
set -euo pipefail
repo_root="${MISE_PROJECT_ROOT:-$(pwd)}"
source_plist="${repo_root}/packages/control-plane/launchd/com.wirebabel.disk-pressure.plist"
target_dir="${HOME}/Library/LaunchAgents"
target_plist="${target_dir}/com.wirebabel.disk-pressure.plist"
domain="gui/$(id -u)"
/usr/bin/plutil -lint "${source_plist}"
/usr/bin/install -d -m 0755 "${target_dir}"
if /bin/launchctl print "${domain}/com.wirebabel.disk-pressure" >/dev/null 2>&1; then
  /bin/launchctl bootout "${domain}/com.wirebabel.disk-pressure"
fi
/usr/bin/install -m 0644 "${source_plist}" "${target_plist}"
/bin/launchctl bootstrap "${domain}" "${target_plist}"
