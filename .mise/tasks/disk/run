#!/usr/bin/env bash
#MISE description="Guard then execute a new workspace, build, download, or proof-capture command"
set -euo pipefail
if [[ $# -lt 2 ]]; then
  printf 'usage: mise run disk:run -- <workspace|build|download|proof> <command> [args...]\n' >&2
  exit 2
fi
operation="$1"
shift
case "${operation}" in
  workspace|build|download|proof) ;;
  *) printf 'disk:run: unsupported heavy operation: %s\n' "${operation}" >&2; exit 2 ;;
esac
repo_root="${MISE_PROJECT_ROOT:-$(pwd)}"
bun "${repo_root}/vendor/oh-my-pi/packages/coding-agent/scripts/disk-pressure.ts" guard --operation "${operation}"
exec "$@"
