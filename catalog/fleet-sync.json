{
  "schemaVersion": 1,
  "schedule": {
    "intervalSeconds": 300,
    "jitterSeconds": 45,
    "backoffSeconds": [60, 300, 900, 1800, 3600]
  },
  "defaults": {
    "maxBytesPerRun": 268435456,
    "excludedPathParts": [
      "secret",
      "secrets",
      "token",
      "credentials",
      "keychain",
      "cache",
      "override",
      "overrides",
      "socket",
      "sockets",
      "tmp",
      "runtime",
      "lease",
      "owner"
    ],
    "trustedConfigKeys": {}
  },
  "hosts": {
    "mac": {
      "stateRoot": "~/Library/Application Support/fleet-sync",
      "peers": [
        {
          "id": "h11dsi",
          "endpoint": {
            "kind": "ssh",
            "host": "h11dsi",
            "root": "/home/arthur/.local/state/fleet-sync"
          }
        },
        {
          "id": "desktop",
          "endpoint": {
            "kind": "ssh",
            "host": "desktop",
            "root": "/home/arthur/.local/state/fleet-sync"
          }
        }
      ],
      "sources": {
        "laneReceiptRoots": ["~/tmp/harness-lanes/bundles"],
        "journalRoots": ["~/.omp/agent/sessions/closed"],
        "assetManifestRoots": ["~/.local/share/fleet-sync/asset-manifests"],
        "configSnapshotRoots": ["~/.local/share/fleet-sync/config-snapshots"],
        "assetRoots": ["~/agents/data", "~/.stema/objects"]
      }
    },
    "h11dsi": {
      "stateRoot": "~/.local/state/fleet-sync",
      "peers": [
        {
          "id": "mac",
          "endpoint": {
            "kind": "ssh",
            "host": "mac",
            "root": "/Users/arthur/Library/Application Support/fleet-sync"
          }
        },
        {
          "id": "desktop",
          "endpoint": {
            "kind": "ssh",
            "host": "desktop",
            "root": "/home/arthur/.local/state/fleet-sync"
          }
        }
      ],
      "sources": {
        "laneReceiptRoots": ["~/tmp/harness-lanes/bundles"],
        "journalRoots": ["~/.omp/agent/sessions/closed"],
        "assetManifestRoots": ["~/.local/share/fleet-sync/asset-manifests"],
        "configSnapshotRoots": ["~/.local/share/fleet-sync/config-snapshots"],
        "assetRoots": ["~/agents/data", "~/.stema/objects"]
      }
    },
    "desktop": {
      "stateRoot": "~/.local/state/fleet-sync",
      "peers": [
        {
          "id": "mac",
          "endpoint": {
            "kind": "ssh",
            "host": "mac",
            "root": "/Users/arthur/Library/Application Support/fleet-sync"
          }
        },
        {
          "id": "h11dsi",
          "endpoint": {
            "kind": "ssh",
            "host": "h11dsi",
            "root": "/home/arthur/.local/state/fleet-sync"
          }
        }
      ],
      "sources": {
        "laneReceiptRoots": ["~/tmp/harness-lanes/bundles"],
        "journalRoots": ["~/.omp/agent/sessions/closed"],
        "assetManifestRoots": ["~/.local/share/fleet-sync/asset-manifests"],
        "configSnapshotRoots": ["~/.local/share/fleet-sync/config-snapshots"],
        "assetRoots": ["~/agents/data", "~/.stema/objects"]
      }
    }
  }
}
